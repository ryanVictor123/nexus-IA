local function CleanMarkdown(text)
    if not text then return "" end
    local s = tostring(text)
    s = s:gsub("^\239\187\191", "")
    s = s:gsub("```json%s*", "")
    s = s:gsub("```%s*", "")
    s = s:gsub("<[%w_]+>", "")
    s = s:gsub("</[%w_]+>", "")
    s = s:gsub("^%s*[Aa]qui est[áa].-:%s*", "")
    s = s:gsub("^%s*[Hh]ere is.*:%s*", "")
    s = s:gsub("^%s*[Rr]esposta:%s*", "")
    s = s:gsub("^%s*[Jj][Ss][Oo][Nn]:%s*", "")
    return s
end

local function ExtractBalancedObject(text)
    local start = text:find("{", 1, true)
    if not start then return nil end

    local depth = 0
    local inString = false
    local escape = false
    local i = start

    while i <= #text do
        local c = text:sub(i, i)
        if escape then
            escape = false
        elseif c == "\\" then
            escape = true
        elseif c == '"' and not escape then
            inString = not inString
        elseif not inString then
            if c == "{" then depth = depth + 1
            elseif c == "}" then
                depth = depth - 1
                if depth == 0 then
                    return text:sub(start, i)
                end
            end
        end
        i = i + 1
    end
    return nil
end

local function RepairJSON(s)
    if not s or s == "" then return s end

    s = s:gsub(",%s*}", "}")
    s = s:gsub(",%s*]", "]")
    s = s:gsub(",,+", ",")
    s = s:gsub("(,)%s*,", "%1")

    s = s:gsub("'([^'\\]*)'%s*:", '"%1":')
    s = s:gsub(":%s*'([^'\\]*)'", ':"%1"')

    s = s:gsub("([{,])%s*([%a_][%w_]*)%s*:", '%1"%2":')

    s = s:gsub(":%s*[Vv]erdadeiro", ":true")
    s = s:gsub(":%s*[Ff]also", ":false")
    s = s:gsub(":%s*[Nn]ulo", ":null")

    return s
end

local function ParseWithFallbacks(text)
    if not text or text == "" then return false, nil, "empty text" end

    local attempts = {}

    table.insert(attempts, text)

    local cleaned = CleanMarkdown(text)
    table.insert(attempts, cleaned)

    local balanced = ExtractBalancedObject(cleaned)
    if balanced then table.insert(attempts, balanced) end

    if balanced then
        local repaired = RepairJSON(balanced)
        if repaired ~= balanced then table.insert(attempts, repaired) end
    end

    local cleanedBalanced = balanced and RepairJSON(CleanMarkdown(balanced))
    if cleanedBalanced then table.insert(attempts, cleanedBalanced) end

    local errors = {}
    for i, attempt in ipairs(attempts) do
        local ok, result = pcall(function()
            return HttpService:JSONDecode(attempt)
        end)
        if ok and type(result) == "table" then
            return true, result, nil, i
        else
            table.insert(errors, "attempt " .. i .. ": " .. tostring(result))
        end
    end

    return false, nil, table.concat(errors, " | ")
end

local function ValidateSchema(obj)
    if type(obj) ~= "table" then return false, "not object" end

    if type(obj.message) ~= "string" then
        if type(obj.message_aborted_and_continued_as_follow_up) == "string" then
            obj.message = obj.message_aborted_and_continued_as_follow_up
        elseif type(obj.response) == "string" then
            obj.message = obj.response
        elseif type(obj.content) == "string" then
            obj.message = obj.content
        elseif type(obj.text) == "string" then
            obj.message = obj.text
        else
            if type(obj.tool_calls) == "table" and #obj.tool_calls > 0 then
                obj.message = "🔍 Querying the game..."
            elseif type(obj.thinking) == "string" and obj.thinking ~= "" then
                obj.message = obj.thinking
            else
                obj.message = "Processing..."
            end
        end
    end

    if type(obj.execute) ~= "boolean" then
        if obj.execute == nil then
            obj.execute = false
        else
            obj.execute = tostring(obj.execute):lower() == "true"
        end
    end

    if type(obj.code) ~= "string" then
        obj.code = obj.code and tostring(obj.code) or ""
    end

    if type(obj.tool_calls) ~= "table" then
        obj.tool_calls = {}
    end

    local cleanCalls = {}
    for _, call in ipairs(obj.tool_calls) do
        if type(call) == "table" then
            local name = call.name or call.tool or call["function"] or call.action
            local args = call.args or call.arguments or call.params or {}
            if type(name) == "string" and name ~= "" then
                table.insert(cleanCalls, { name = name, args = args })
            end
        elseif type(call) == "string" then
            table.insert(cleanCalls, { name = call, args = {} })
        end
    end
    obj.tool_calls = cleanCalls

    if type(obj.thinking) ~= "string" then
        obj.thinking = obj.thinking and tostring(obj.thinking) or ""
    end

    if type(obj.thinking_title) ~= "string" then
        obj.thinking_title = obj.thinking_title and tostring(obj.thinking_title) or "THINKING"
    end

if type(obj.suggestions) ~= "table" then
    obj.suggestions = {}
end
local cleanSug = {}
for _, s in ipairs(obj.suggestions) do
    if type(s) == "string" and s ~= "" then
        local txt = s:gsub("^%s+", ""):gsub("%s+$", "")

        if #txt <= 40 and not txt:find("%s+%.%.%.$") and not txt:find("%.%.%.") then
            table.insert(cleanSug, txt)
            if #cleanSug >= 4 then break end
        end
    end
end
obj.suggestions = cleanSug

    return true, nil
end

function JSONForcer.Extract(rawText)
    local ok, obj, err, layer = ParseWithFallbacks(rawText)
    if not ok then
        return false, nil, err
    end
    local valid, verr = ValidateSchema(obj)
    if not valid then
        return false, nil, "schema: " .. tostring(verr)
    end
    return true, obj, nil, layer
end

