            end

            local payload={
                author_id=UID,
                name=nm,
                description=ds,
                prompt_extension=pext,
                prompt_modifier=pmod,
                custom_tools=ct,
                suggestions=sugg,
                icon_url=ico,
                version=(vers=="" and "1.0.0" or vers)
