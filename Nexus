NEXUS_TOOLS.describe_scene = {
    desc = "Generates a natural textual description (like narration) of nearby environment: part types, colors, sounds, players, NPCs.",
    args = { "radius (studs, default 80)" },
    fn = function(args)
        local hrp = V4HRP()
        if not hrp then return "No HRP." end
        local radius = tonumber(args.radius) or 80

        local mats, cols, shapes = {}, {}, {}
        local count = 0
        for _, inst in ipairs(workspace:GetDescendants()) do
            if inst:IsA("BasePart") and (inst.Position - hrp.Position).Magnitude <= radius then
                count = count + 1
                mats[tostring(inst.Material)] = (mats[tostring(inst.Material)] or 0) + 1
                shapes[tostring(inst.Shape)] = (shapes[tostring(inst.Shape)] or 0) + 1
            end
        end

        local function topN(t, n)
            local arr = {}
            for k, v in pairs(t) do table.insert(arr, { k, v }) end
            table.sort(arr, function(a, b) return a[2] > b[2] end)
            local out = {}
            for i = 1, math.min(n, #arr) do table.insert(out, arr[i][1] .. " (" .. arr[i][2] .. ")") end
            return table.concat(out, ", ")
        end

        local playersNear = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = p.Character:FindFirstChild("HumanoidRootPart")
                if h and (h.Position - hrp.Position).Magnitude <= radius then
                    playersNear = playersNear + 1
                end
            end
        end

        local lightStr = string.format("Lighting: ClockTime %.1f, Ambient (%d,%d,%d)",
            Lighting.ClockTime,
            Lighting.Ambient.R * 255, Lighting.Ambient.G * 255, Lighting.Ambient.B * 255)

        return table.concat({
            "=== SCENE DESCRIPTION (radius " .. radius .. " studs) ===",
            "Nearby objects: " .. count,
            "Predominant materials: " .. topN(mats, 5),
            "Predominant shapes: " .. topN(shapes, 4),
            "Players within range: " .. playersNear,
            lightStr,
            "Gravity: " .. workspace.Gravity,
        }, "\n")
    end
}

NEXUS_TOOLS.analyze_geometry = {
    desc = "Fires rays in a grid around the player and infers structure: nearby walls, open directions.",
    args = { "radius (studs, default 40)" },
    fn = function()
        local hrp = V4HRP()
        if not hrp then return "No HRP." end
        local radius = tonumber(args.radius) or 40

        local directions = {
            { "North (-Z)", Vector3.new(0, 0, -1) },
            { "South (+Z)", Vector3.new(0, 0, 1) },
            { "East (+X)", Vector3.new(1, 0, 0) },
            { "West (-X)", Vector3.new(-1, 0, 0) },
        }
        local lines = { "=== GEOMETRY (radius " .. radius .. ") ===" }
        for _, d in ipairs(directions) do
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { V4Char() }
            local res = workspace:Raycast(hrp.Position, d[2] * radius, params)
            if res then
                table.insert(lines, d[1] .. ": wall at " .. math.floor(res.Distance) .. " studs (" .. res.Instance.Name .. ")")
            else
                table.insert(lines, d[1] .. ": OPEN up to " .. radius .. " studs")
            end
        end
        local down = workspace:Raycast(hrp.Position, Vector3.new(0, -50, 0), nil)
        if down then
            table.insert(lines, "Floor: " .. math.floor(down.Distance) .. " studs below (" .. down.Instance.Name .. ")")
        end
        return table.concat(lines, "\n")
    end
}

NEXUS_TOOLS.find_patterns = {
    desc = "Groups instances by name prefix (before digits/underscore) and shows groups with many repetitions (useful for tiles, spawns, waypoints).",
    args = { "root (default workspace)", "min_count (default 5)" },
    fn = function(args)
        local r = tostring(args.root or "workspace"):lower()
        local root = workspace
        if r == "replicatedstorage" then root = ReplicatedStorage
        elseif r == "game" then root = game end
        local min_count = tonumber(args.min_count) or 5

        local groups = {}
        for _, inst in ipairs(root:GetDescendants()) do
            local base = inst.Name:gsub("%d+$", ""):gsub("[_%-]+$", "")
            if #base >= 3 then
                groups[base] = groups[base] or { count = 0, class = inst.ClassName, sample = inst:GetFullName() }
                groups[base].count = groups[base].count + 1
            end
        end

        local arr = {}
        for name, data in pairs(groups) do
            if data.count >= min_count then
                table.insert(arr, { name = name, count = data.count, class = data.class, sample = data.sample })
            end
        end
        table.sort(arr, function(a, b) return a.count > b.count end)

        local lines = { "=== REPEATED PATTERNS (min " .. min_count .. ") ===" }
        for i = 1, math.min(#arr, 25) do
            local g = arr[i]
            table.insert(lines, string.format("- %s [%s] x%d  (e.g. %s)", g.name, g.class, g.count, g.sample))
        end
        if #lines == 1 then return "No significant pattern found." end
        return table.concat(lines, "\n")
    end
}

NEXUS_TOOLS.profile_npcs = {
    desc = "Records position of all NPCs for N seconds and infers if they are stationary, moving linearly, or in circular route.",
    args = { "duration (seconds, default 10)" },
    fn = function()
        local duration = tonumber(args.duration) or 10
        local playerChars = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then playerChars[p.Character] = true end
        end

        local npcs = {}
        for _, m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") and not playerChars[m] then
                local hrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                if hrp then
                    npcs[m] = { samples = { { t = 0, p = hrp.Position } } }
                end
            end
        end

        if not next(npcs) then return "No NPC found." end

        local start = tick()
        while tick() - start < duration do
            for model, data in pairs(npcs) do
                local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                if hrp then
                    table.insert(data.samples, { t = tick() - start, p = hrp.Position })
                end
            end
            task.wait(0.25)
        end

        local lines = { "=== NPC PROFILE (" .. duration .. "s) ===" }
        for model, data in pairs(npcs) do
            local s = data.samples
            if #s >= 3 then
                local totalDist = 0
                for i = 2, #s do totalDist = totalDist + (s[i].p - s[i-1].p).Magnitude end
                local first, last = s[1].p, s[#s].p
                local closed = (first - last).Magnitude
                local behavior
                if totalDist < 2 then behavior = "STATIONARY"
                elseif closed < totalDist * 0.2 then behavior = "CIRCULAR ROUTE"
                else behavior = "LINEAR MOVEMENT" end
                table.insert(lines, string.format("- %s: %s | dist: %.1f | closed: %.1f",
                    model.Name, behavior, totalDist, closed))
            end
        end
        return table.concat(lines, "\n")
    end
}

