-- REFUSAL DETECTION
------------------------------------------------------------
local function IsRefusalResponse(text)
    if not text then return false end
    local lower = tostring(text):lower()

    if lower:find("{", 1, true) and lower:find("thinking_title", 1, true) then
        return false
    end

    -- ====================================================
    -- DETECÇÃO DE "SAFETY RESPONSE" DO PROVEDOR
    -- Quando o modelo não gera conteúdo, o provedor retorna:
    --   "User safety: safe\nResponse Safety: safe"
    -- Isso NÃO é resposta real. Trata como recusa pra forçar
    -- fallback automático pra outro modelo.
    -- ====================================================
    local compact = lower:gsub("%s+", " ")
    compact = compact:gsub("^%s+", ""):gsub("%s+$", "")
    if #compact > 0 and #compact < 200 then
        if compact:find("user safety", 1, true)
            or compact:find("response safety", 1, true)
            or compact:find("safety: safe", 1, true)
            or compact:find("safety: unsafe", 1, true)
            or compact:find("safety classifier", 1, true)
            or compact:find("safety rating", 1, true) then
            return true
        end
        -- Se for muito curto e só tem "safety" e "safe", também é isso
        if compact:find("safety", 1, true) and compact:find("safe", 1, true) then
            return true
        end
    end

    local refusalPatterns = {
        "i can't help", "i cannot help", "i'm sorry, but i can't",
        "i'm unable to", "i won't", "i will not", "i can not assist",
        "i can't assist", "i cannot assist", "cannot provide",
        "can't provide", "not able to help", "against my policy",
        "violates", "violation of policy", "policy violation",
        "i must decline", "i must refuse", "unable to comply",
        "not something i can", "i don't feel comfortable",
        "i do not feel comfortable", "i'm not able to",
        "não posso ajudar", "não posso auxiliar", "não posso fornecer",
        "não vou ajudar", "não posso fazer isso", "contra minhas diretrizes",
        "contra minhas políticas", "não é permitido", "não posso atender",
        "não consigo ajudar", "não consigo fazer isso"
    }

    for _, pat in ipairs(refusalPatterns) do
        if lower:find(pat, 1, true) then
            return true
        end
    end
    return false
end

-- ============================================================
-- IA HEALTH — connection health tracker (circuit breaker)
-- ============================================================
local IAHealth = {
    consecutiveSuccess = 0,
    consecutiveFail    = 0,
    lastFailTime       = 0,
    isHealthy          = true,

    RecoverySuccesses  = 1,
    UnhealthyAfterFail = 3,
    AutoRecoveryTime   = 20,

    totalRequests      = 0,
    totalSuccesses     = 0,
    totalFails         = 0,
    totalCyclesUsed    = 0,
}

local function IAHealth_MarkSuccess()
    IAHealth.consecutiveSuccess = IAHealth.consecutiveSuccess + 1
    IAHealth.consecutiveFail    = 0
    IAHealth.totalSuccesses     = IAHealth.totalSuccesses + 1
    if IAHealth.consecutiveSuccess >= IAHealth.RecoverySuccesses then
        IAHealth.isHealthy = true
    end
end

local function IAHealth_MarkFail()
    IAHealth.consecutiveFail    = IAHealth.consecutiveFail + 1
    IAHealth.consecutiveSuccess = 0
    IAHealth.lastFailTime       = tick()
    IAHealth.totalFails         = IAHealth.totalFails + 1
    if IAHealth.consecutiveFail >= IAHealth.UnhealthyAfterFail then
        IAHealth.isHealthy = false
    end
end

local function IAHealth_Check()
    if not IAHealth.isHealthy and IAHealth.lastFailTime > 0 then
        if tick() - IAHealth.lastFailTime > IAHealth.AutoRecoveryTime then
            IAHealth.isHealthy = true
            IAHealth.consecutiveFail = 0
            print("[IAHealth] Recovered by time (45s without fails).")
        end
    end
    return IAHealth.isHealthy
end

