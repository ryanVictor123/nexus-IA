    Animate(LoadingTitle, 0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.In, { TextTransparency = 1 })
    Animate(LoadingStatus, 0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In, { TextTransparency = 1 })
    Animate(PercentLabel, 0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In, { TextTransparency = 1 })
