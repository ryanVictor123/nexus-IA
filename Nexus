        local function Hook(inst)
            if hooked[inst] then return end
            hooked[inst] = true
            local mt = getrawmetatable and getrawmetatable(inst)
            if mt and mt.__namecall then
                local old = mt.__namecall
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod and getnamecallmethod() or "?"
                    if self == inst and (method == "FireServer" or method == "InvokeServer") then
                        local args = { ... }
                        local parts = {}
                        for _, a in ipairs(args) do
                            table.insert(parts, typeof(a) == "Instance" and (a:GetFullName()) or tostring(a))
                        end
                        table.insert(_G._nexusRemoteLog, {
                            time = os.time(),
                            name = inst:GetFullName(),
                            method = method,
                            args = table.concat(parts, ", ")
                        })
                    end
                    return old(self, ...)
                end)
                setreadonly(mt, true)
            end
        end

        for _, inst in ipairs(game:GetDescendants()) do
            if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
                pcall(Hook, inst)
            end
        end

        task.delay(30, function()
            _G._nexusRemoteHookEnabled = false
        end)

        return "Log active for 30s. Use 'get_remote_log' after."
    end
}

