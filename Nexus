local AntiSpam = { last = 0, lastText = "" }

local function CheckSpam(text)
    -- Retry interno do SmartRequest nunca é spam
    if _G._nexusInternalRetry then return true, "" end

    local now = tick()

    -- Evita double-click no SEND e Enter segurado
    if now - AntiSpam.last < 0.4 then
        return false, "Calm down, still processing.."
    end

    -- Evita mandar a MESMA coisa 2x sem querer
    -- (Enter duplo, click acidental, etc)
    if text == AntiSpam.lastText and now - AntiSpam.last < 3 then
        return false, "Same message. Something changes.."
    end

    AntiSpam.last, AntiSpam.lastText = now, text
    return true, ""
end

