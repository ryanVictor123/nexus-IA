-- ====================================================
-- TYPEWRITER — thinking aparece letra por letra
-- Velocidade varia: pausa em vírgula/ponto/quebra.
-- Cursor pisca enquanto digita.
-- ====================================================
-- ====================================================
-- TYPEWRITER EM 2 FASES — pausa "pensando" no meio
-- Fase 1: digita até a metade
-- Pausa: reticências animadas (parece pensando)
-- Fase 2: completa o resto com cursor
-- ====================================================
task.spawn(function()
    local full = tostring(thinkingData)
    if full == "" then return end

    local BASE_SPEED = 0.012

    local function pauseFor(ch)
        if ch == "\n" then return 0.22 end
        if ch == "." or ch == "!" or ch == "?" then return 0.18 end
        if ch == "," or ch == ";" or ch == ":" then return 0.09 end
        if ch == " " then return 0.02 end
        return BASE_SPEED
    end

    local function scrollToBottom()
        ChatScroll.CanvasPosition = Vector2.new(
            0,
            math.max(0, ChatScroll.AbsoluteCanvasSize.Y)
        )
    end

    -- ====================================================
    -- Divide em 2 partes: metade no meio lógico (quebra de linha
    -- mais próxima da metade) pra não cortar frase no meio
    -- ====================================================
    local half = math.floor(#full / 2)
    local splitPos = half

    -- Procura quebra de linha ou ponto final próximo da metade
    local searchStart = math.max(1, half - 40)
    local searchEnd = math.min(#full, half + 40)
    local bestSplit = nil
    for i = searchStart, searchEnd do
        local ch = full:sub(i, i)
        if ch == "\n" or ch == "." or ch == "!" or ch == "?" then
            if not bestSplit or math.abs(i - half) < math.abs(bestSplit - half) then
                bestSplit = i
            end
        end
    end
    if bestSplit then splitPos = bestSplit end

    local part1 = full:sub(1, splitPos)
    local part2 = full:sub(splitPos + 1)

    -- ====================================================
    -- FASE 1 — digita a primeira metade
    -- ====================================================
    for i = 1, #part1 do
        if not ThinkText.Parent then return end
        local ch = part1:sub(i, i)
        ThinkText.Text = part1:sub(1, i) .. "▌"
        scrollToBottom()
        task.wait(pauseFor(ch))
    end

    -- ====================================================
    -- PAUSA "PENSANDO" — reticências animadas
    -- Dura enquanto for proporcional ao tamanho do pensamento
    -- (mínimo 0.8s, máximo 2.5s)
    -- ====================================================
    local pauseDuration = math.clamp(#full * 0.008, 0.8, 2.5)
    local pauseStart = tick()
    local dotsCycle = { "▌", ".▌", "..▌", "...▌", "..▌", ".▌" }
    local dotIdx = 1

    while tick() - pauseStart < pauseDuration do
        if not ThinkText.Parent then return end
        ThinkText.Text = part1 .. dotsCycle[dotIdx]
        scrollToBottom()
        dotIdx = dotIdx + 1
        if dotIdx > #dotsCycle then dotIdx = 1 end
