local function ExecuteDynamicCode(code)
    local loadFunc = loadstring or (syn and syn.loadstring) or (Fluxus and Fluxus.loadstring)
    if not loadFunc then return false, "Executor does not support loadstring." end

    -- Preâmbulo sem indentação + newline garantido no final
    local prelude =
        'local Players = game:GetService("Players")\n' ..
        'local LocalPlayer = Players.LocalPlayer\n' ..
        'local Character = LocalPlayer and LocalPlayer.Character\n' ..
        'local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")\n' ..
        'local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")\n'

    -- Garante que o código da IA começa em linha nova
    local aiCode = tostring(code or "")
    if aiCode:sub(1, 1) == "\n" then
        aiCode = aiCode:sub(2)
    end

    local formattedCode = prelude .. "\n" .. aiCode

    -- Compila com chunk name pra erro apontar arquivo certo
    local compiledCode, compileErr = loadFunc(formattedCode, "=NEXUS_DYNAMIC")
    if not compiledCode then
        warn("[NEXUS DYN] Código da IA inválido:\n" .. formattedCode)
        return false, "Luau compilation error: " .. tostring(compileErr)
    end

    local success, execErr = pcall(compiledCode)
    if not success then
        return false, "Runtime error: " .. tostring(execErr)
    end

    return true, "Executed successfully!"
end

