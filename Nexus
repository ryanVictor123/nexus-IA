-- ============================================================

local function GetReq()
    if typeof(request) == "function" then return request end
    if typeof(http_request) == "function" then return http_request end
    if syn and typeof(syn.request) == "function" then return syn.request end
    if fluxus and typeof(fluxus.request) == "function" then return fluxus.request end
    if http and typeof(http.request) == "function" then return http.request end
end

local function HTTP(method, path, body)
    local req = GetReq()
    if not req then
        return false, "HTTP request is unavailable."
    end

    local url = CATALOG_URL .. path

    local p = {
        Url = url,
        url = url,
        Method = method,
        method = method,

        Headers = {
            ["Content-Type"] = "application/json"
        },
    }

    if body then
        local e = HttpService:JSONEncode(body)
        p.Body = e
        p.body = e
    end

    local ok, res = pcall(function()
        return req(p)
    end)

    if not ok or not res then
        return false, "Connection failed."
    end

    local status =
        res.StatusCode
        or res.status_code
        or res.Status

    local rbody =
        res.Body
        or res.body

    if not rbody then
        return false, "Empty response."
    end

    local okD, decoded = pcall(function()
        return HttpService:JSONDecode(rbody)
    end)

    if not okD then
        return false, "Invalid JSON response."
    end

    local sc = tonumber(status)

    if sc and sc >= 400 then
        local reason = "HTTP " .. sc

        if type(decoded) == "table" then
            reason =
                decoded.reason
                or decoded.error
                or reason
        end

        return false, reason, decoded
    end

    return true, decoded
end

