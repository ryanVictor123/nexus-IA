local TopbarIcon

local MainStroke = MainFrame:FindFirstChildOfClass("UIStroke")

local function OpenPanel()
    if IsPanelVisible then return end
    IsPanelVisible = true
    MainFrame.Visible = true

    -- Reset pra estado "invisível"
    MainFrame.Position = UDim2.fromScale(0.5, 0.58)
    MainFrame.BackgroundTransparency = 1
    MainScale.Scale = 0.92

    -- Sobe com "bounce"
    Animate(MainFrame, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
        Position = UDim2.fromScale(0.5, 0.5)
    })

    -- Fade do fundo (só o fundo, não os filhos)
    Animate(MainFrame, 0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {
        BackgroundTransparency = 0
    })

    -- Scale com "pop"
    Animate(MainScale, 0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
        Scale = 1
    })

    if TopbarIcon and not TopbarIcon.isSelected then
        TopbarIcon:select()
    end
end

local function ClosePanel()
    if not IsPanelVisible then return end
    IsPanelVisible = false

    -- Encolhe
    Animate(MainScale, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In, {
        Scale = 0.94
    })

    -- Desce + fade do fundo
    local slide = Animate(MainFrame, 0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.In, {
        Position = UDim2.fromScale(0.5, 0.56),
        BackgroundTransparency = 1
    })

    slide.Completed:Connect(function()
        if not IsPanelVisible then
            MainFrame.Visible = false
        end
    end)

    if TopbarIcon and TopbarIcon.isSelected then
        TopbarIcon:deselect()
    end
end

