NEXUS_TOOLS.session_record_start = {
    desc = "Starts session recording: position, HP, WalkSpeed, equipped tool. Saves in memory for replay.",
    args = {},
    fn = function()
        if V4.Rec.active then return "Already recording. Use session_record_stop." end
        V4.Rec = { active = true, startTime = tick(), frames = {}, events = {} }
        V4Conn("rec_pos", RS4.Heartbeat:Connect(function()
            local h = V4Hum(); local hrp = V4HRP()
            if h and hrp then
                table.insert(V4.Rec.frames, {
                    t = tick() - V4.Rec.startTime,
                    pos = hrp.Position,
                    hp = h.Health,
                    ws = h.WalkSpeed,
                })
                if #V4.Rec.frames > 20000 then table.remove(V4.Rec.frames, 1) end
            end
        end))
        V4Conn("rec_die", LocalPlayer.CharacterAdded:Connect(function()
            table.insert(V4.Rec.events, { t = tick() - V4.Rec.startTime, type = "respawn" })
        end))
        return "Recording started. 🔴"
    end
}

NEXUS_TOOLS.session_record_stop = {
    desc = "Stops recording and returns session summary (duration, distance, deaths, etc).",
    args = {},
    fn = function()
        if not V4.Rec.active then return "Nothing recorded." end
        V4.Rec.active = false
        V4Disc("rec_pos")
        V4Disc("rec_die")

        local frames = V4.Rec.frames
        local total = 0
        for i = 2, #frames do
            total = total + (frames[i].pos - frames[i-1].pos).Magnitude
        end
        local deaths = 0
        for _, e in ipairs(V4.Rec.events) do
            if e.type == "respawn" then deaths = deaths + 1 end
        end
        return string.format(
            "Recording saved. Duration: %.1fs | Frames: %d | Distance traveled: %.1f studs | Deaths: %d",
            frames[#frames] and frames[#frames].t or 0, #frames, total, deaths)
    end
}

