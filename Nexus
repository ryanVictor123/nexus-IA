    local function selectTab(name)

        if currentTab == name then
            return
        end

        currentTab = name

        for n, p in pairs(tabPages) do
            p.Visible =
                n == name
        end

        for n, b in pairs(tabButtons) do

            local on =
                n == name

            tw(
                b,
                0.15,
                {
                    BackgroundColor3 =
                        on
                        and Color3.fromRGB(
                            30,
                            30,
                            34
                        )
                        or Color3.fromRGB(
                            15,
                            15,
                            18
                        ),

                    TextColor3 =
                        on
                        and C.Text
                        or C.TextMuted,
                }
            )
        end
    end

