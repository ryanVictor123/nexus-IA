local INSTALL_MARKER = ".nexus_install_mark"

-- Simple deterministic hash
local function SignPayload(used, date, lastTs)
    local raw = tostring(used) .. "|" .. tostring(date) .. "|" ..
                tostring(lastTs) .. "|" .. SECRET_KEY
    local h1, h2 = 5381, 52711
    for i = 1, #raw do
        local b = string.byte(raw, i)
        h1 = (h1 * 33 + b) % 4294967291
        h2 = (h2 * 31 + b * (i % 7 + 1)) % 4294967279
    end
    return string.format("%08x%08x", h1, h2)
end

local function SignFile(data)
    return SignPayload(data.used, data.date, data.lastTimestamp or 0)
end

