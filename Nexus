    fn = function(args)
        local cam = workspace.CurrentCamera
        local myChar = GetMyChar()
        if not cam then return "No camera." end
        local dist = tonumber(args.distance) or 50
        local angle = math.rad(tonumber(args.angle) or 30)
        local origin = cam.CFrame.Position
        local look = cam.CFrame.LookVector

        local hits = {}
        for _, inst in ipairs(workspace:GetDescendants()) do
            if inst:IsA("BasePart") and not (myChar and inst:IsDescendantOf(myChar)) then
                local v = inst.Position - origin
                local d = v.Magnitude
                if d <= dist and d > 0 then
                    local cosA = v.Unit:Dot(look)
                    if cosA >= math.cos(angle) then
                        table.insert(hits, { d, inst:GetFullName() .. " (" .. inst.ClassName .. ") " .. string.format("%.1f", d) .. " studs" })
                    end
                end
            end
        end
        table.sort(hits, function(a, b) return a[1] < b[1] end)
        local lines = {}
        for i = 1, math.min(#hits, 20) do table.insert(lines, hits[i][2]) end
        if #lines == 0 then return "Nothing in cone." end
        return "Objects ahead:\n" .. table.concat(lines, "\n")
    end
}

