local function ApplyTamperPenalty(reason)
    DailyLimit.tampered = true
    DailyLimit.used = DAILY_LIMIT
    DailyLimit.date = GetTodayKey()
    DailyLimit.lastTimestamp = os.time()
    print("[NEXUS] ⚠️ TAMPER DETECTED (" .. tostring(reason) .. ") — limit locked for today.")
end

