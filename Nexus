local function UAPerceive()
    local obs = {}
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    obs.genre = UA.genre
    obs.confidence = math.floor(UA.confidence * 100)

    obs.self = {
        hp = hum and math.floor(hum.Health) or 0,
        maxHp = hum and math.floor(hum.MaxHealth) or 100,
        pos = hrp and { math.floor(hrp.Position.X), math.floor(hrp.Position.Y), math.floor(hrp.Position.Z) },
        state = hum and hum:GetState().Name or "?",
        tool = char and char:FindFirstChildOfClass("Tool") and char:FindFirstChildOfClass("Tool").Name or nil,
    }

    obs.interactables = {}
    for i, item in ipairs(UAPrimitives.scan_interactables(150)) do
        if i > 8 then break end
        obs.interactables[i] = { name = item.name, dist = item.dist, pos = item.pos }
    end

    obs.players = {}
    if hrp then
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = p.Character:FindFirstChild("HumanoidRootPart")
                local hh = p.Character:FindFirstChildOfClass("Humanoid")
                if h and hh then
                    table.insert(list, { name = p.Name, hp = math.floor(hh.Health), dist = math.floor((h.Position - hrp.Position).Magnitude) })
                end
            end
        end
        table.sort(list, function(a, b) return a.dist < b.dist end)
        for i = 1, math.min(5, #list) do obs.players[i] = list[i] end
    end

    obs.npcs = {}
    if hrp then
        local pChars = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then pChars[p.Character] = true end
        end
        local list = {}
        for _, m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") and not pChars[m] then
                local h = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                local hh = m:FindFirstChildOfClass("Humanoid")
                if h and hh then
                    local d = (h.Position - hrp.Position).Magnitude
                    if d < 100 then
                        table.insert(list, { name = m.Name, hp = math.floor(hh.Health), dist = math.floor(d) })
                    end
                end
            end
        end
        table.sort(list, function(a, b) return a.dist < b.dist end)
        for i = 1, math.min(4, #list) do obs.npcs[i] = list[i] end
    end

    obs.stats = {}
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        for _, s in ipairs(ls:GetChildren()) do obs.stats[s.Name] = tostring(s.Value) end
    end

    obs.buttons = {}
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        local count = 0
        for _, inst in ipairs(pg:GetDescendants()) do
            if (inst:IsA("TextButton") or inst:IsA("ImageButton")) and inst.Visible then
                count = count + 1
                if count <= 10 then
                    local txt = inst:IsA("TextButton") and inst.Text or inst.Name
                    if txt and #txt >= 2 then obs.buttons[txt] = true end
                end
            end
        end
    end

    return obs
end

