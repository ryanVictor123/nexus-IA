local function ScanDirectory(instance, maxDepth, currentDepth)
    currentDepth = currentDepth or 1
    if currentDepth > maxDepth then return "..." end

    local tree = {}
    local children = instance:GetChildren()

    for i = 1, math.min(#children, 25) do
        local child = children[i]
        if child.Name ~= GUI_NAME then
            local info = child.Name .. " (" .. child.ClassName .. ")"
            if #child:GetChildren() > 0 and currentDepth < maxDepth then
                info = info .. " { " .. ScanDirectory(child, maxDepth, currentDepth + 1) .. " }"
            end
            table.insert(tree, info)
        end
    end

    if #children > 25 then
        table.insert(tree, "+ " .. (#children - 25) .. " more objects")
    end

    return table.concat(tree, ", ")
end

