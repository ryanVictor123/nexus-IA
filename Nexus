local function SaveDailyLimit()
    if not writefile then return end

    local payload = {
        used = DailyLimit.used,
        date = DailyLimit.date,
        lastTimestamp = DailyLimit.lastTimestamp,
        sig = SignFile(DailyLimit),
        v = 4,
    }

    local encoded = HttpService:JSONEncode(payload)

    pcall(function() writefile(LIMIT_FILE_A, encoded) end)
    pcall(function() writefile(LIMIT_FILE_B, encoded) end)
    SetAllTraces()
end

-- ============================================================
-- READ ONE FILE
-- ============================================================

local function ReadOneFile(path)
    if not readfile then return nil, "no_readfile" end

    local exists = true
    if isfile then
        local ok, r = pcall(isfile, path)
        exists = ok and r
    end
    if not exists then return nil, "not_found" end

    local ok, content = pcall(readfile, path)
    if not ok or not content or content == "" then
        return nil, "read_fail"
    end

    local okDec, decoded = pcall(function() return HttpService:JSONDecode(content) end)
    if not okDec or type(decoded) ~= "table" then
        return nil, "invalid_json"
    end

    if type(decoded.used) ~= "number"
        or type(decoded.date) ~= "string"
        or type(decoded.sig) ~= "string" then
        return nil, "missing_fields"
    end

    if type(decoded.lastTimestamp) ~= "number" then
        decoded.lastTimestamp = 0
    end

    local expected = SignFile(decoded)
    if expected ~= decoded.sig then
        return nil, "bad_signature"
    end

    local dateOk, dateReason = IsDatePlausible(decoded.date)
    if not dateOk then
        return nil, "bad_date:" .. dateReason
    end

    if not IsUsedPlausible(decoded.used) then
        return nil, "bad_used"
    end

    return decoded, "ok"
end

-- ============================================================
-- LOAD
-- ============================================================

local function LoadDailyLimit()
    local today = GetTodayKey()
    local now = os.time()

    local dataA, reasonA = ReadOneFile(LIMIT_FILE_A)
    local dataB, reasonB = ReadOneFile(LIMIT_FILE_B)

    local chosen, chosenReason = nil, nil

    if dataA then
        chosen, chosenReason = dataA, "A"
    elseif dataB then
        chosen, chosenReason = dataB, "B"
    end

    -- CASO 1: nenhum arquivo válido
    if not chosen then
        local aExists = reasonA ~= "not_found"
        local bExists = reasonB ~= "not_found"

        if aExists and bExists then
            ApplyTamperPenalty("both_corrupt")
            SaveDailyLimit()
            return
        end

        if aExists or bExists then
            ApplyTamperPenalty("one_corrupt")
            SaveDailyLimit()
            return
        end

        if HasAnyTrace() then
            ApplyTamperPenalty("files_deleted")
            SaveDailyLimit()
            return
        end

        DailyLimit.used = 0
        DailyLimit.date = today
        DailyLimit.lastTimestamp = now
        SaveDailyLimit()
        return
    end

    -- CASO 2: clock manipulation
    if chosen.lastTimestamp and chosen.lastTimestamp > 0 then
        if now < chosen.lastTimestamp - 60 then
            ApplyTamperPenalty("clock_rolled_back")
            SaveDailyLimit()
            return
        end
    end

    -- CASO 3: data mudou → reset
    if chosen.date ~= today then
        DailyLimit.date = today
        DailyLimit.used = 0
        DailyLimit.lastTimestamp = now
        SaveDailyLimit()
        print("[NEXUS] Daily limit reset for " .. today)
        return
    end

    -- CASO 4: mesmo dia, carrega normal
    DailyLimit.used = chosen.used
    DailyLimit.date = chosen.date
    DailyLimit.lastTimestamp = math.max(chosen.lastTimestamp or 0, now)

    if not dataA or not dataB then
        print("[NEXUS] Restoring missing limit file...")
        SaveDailyLimit()
    end

    print(string.format("[NEXUS] Daily limit loaded from %s: %d/%d",
        chosenReason, DailyLimit.used, DailyLimit.limit))
end

-- ============================================================
-- SLOT CONSUMPTION
-- ============================================================

local function GetRemainingMessages()
    return math.max(0, DailyLimit.limit - DailyLimit.used)
end

local function ConsumeMessageSlot()
    if DailyLimit.tampered then
        return false, 0
    end

    LoadDailyLimit()

    if DailyLimit.tampered then
        return false, 0
    end

    if DailyLimit.used >= DailyLimit.limit then
        return false, GetRemainingMessages()
    end

    DailyLimit.used = DailyLimit.used + 1
    DailyLimit.lastTimestamp = os.time()
    SaveDailyLimit()
    return true, GetRemainingMessages()
end

local function GetLimitResetTime()
    local tomorrow = os.date("*t", os.time() + 86400)
    return "00:00",
           string.format("%02d/%02d", tomorrow.day, tomorrow.month)
end

