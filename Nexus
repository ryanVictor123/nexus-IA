local UAPrimitives = {}

function UAPrimitives.navigate_to(x, y, z, timeout)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false, "no character" end

    local target = Vector3.new(x, y, z)
    local path = PathfindingService:CreatePath({
        AgentHeight = 5, AgentRadius = 2, AgentCanJump = true,
    })
    local ok = pcall(function() path:ComputeAsync(hrp.Position, target) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then
        hum:MoveTo(target)
        task.wait(timeout or 3)
        return true, "direct movement (no path)"
    end

    local waypoints = path:GetWaypoints()
    local startT = tick()
    for _, wp in ipairs(waypoints) do
        if tick() - startT > (timeout or 15) then break end
        if wp.Action == Enum.PathWaypointAction.Jump then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
        hum:MoveTo(wp.Position)
        local reached = false
        local checkConn
        checkConn = RunService.Heartbeat:Connect(function()
            if not hrp.Parent then return end
            if (hrp.Position - wp.Position).Magnitude < 4 then
                reached = true
                checkConn:Disconnect()
            end
        end)
        local waitT = tick()
        while not reached and tick() - waitT < 3 do task.wait(0.1) end
        checkConn:Disconnect()
    end
    return true, "navigated to destination"
end

function UAPrimitives.interact_nearest()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "no HRP" end

    local best, bestD
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("ProximityPrompt") and inst.Enabled then
            local part = inst.Parent
            if part and part:IsA("BasePart") then
                local d = (part.Position - hrp.Position).Magnitude
                if d < 30 and (not bestD or d < bestD) then
                    best, bestD = inst, d
                end
            end
        end
    end
    if not best then return false, "no prompt nearby" end

    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(best)
        else
            best.HoldDuration = 0
            best:InputHoldBegin()
            task.wait(0.05)
            best:InputHoldEnd()
        end
    end)
    return true, "interacted with prompt at " .. math.floor(bestD) .. " studs"
end

function UAPrimitives.click_nearest_detector()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "no HRP" end

    local best, bestD
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("ClickDetector") and inst.Parent and inst.Parent:IsA("BasePart") then
            local d = (inst.Parent.Position - hrp.Position).Magnitude
            if d < 40 and (not bestD or d < bestD) then
                best, bestD = inst, d
            end
        end
    end
    if not best then return false, "no ClickDetector" end

    pcall(function()
        if fireclickdetector then
            fireclickdetector(best)
        else
            best.MouseClick:Fire()
        end
    end)
    return true, "clicked detector at " .. math.floor(bestD) .. " studs"
end

function UAPrimitives.click_button(textContains)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false, "no PlayerGui" end
    local needle = tostring(textContains or ""):lower()
    for _, inst in ipairs(pg:GetDescendants()) do
        if (inst:IsA("TextButton") or inst:IsA("ImageButton")) and inst.Visible then
            local label = inst:IsA("TextButton") and inst.Text or inst.Name
            if label and label:lower():find(needle, 1, true) then
                pcall(function() inst:Activate() end)
                return true, "clicked: " .. label
            end
        end
    end
    return false, "button not found: " .. textContains
end

function UAPrimitives.say(text)
    local ok = pcall(function()
        local legacy = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if legacy and legacy:FindFirstChild("SayMessageRequest") then
            legacy.SayMessageRequest:FireServer(text, "All")
            return
        end
        local TCS = game:GetService("TextChatService")
        if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
            local ch = TCS.TextChannels:FindFirstChild("RBXGeneral")
            if ch then ch:SendAsync(text) end
        end
    end)
    return ok, ok and ("said: " .. text) or "failed to speak"
end

function UAPrimitives.equip_tool(nameContains)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not bp or not hum then return false, "no backpack/character" end
    local n = tostring(nameContains or ""):lower()
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find(n, 1, true) then
            hum:EquipTool(t)
            return true, "equipped " .. t.Name
        end
    end
    return false, "tool not found"
end

function UAPrimitives.use_tool()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then return false, "no tool equipped" end
    pcall(function() tool:Activate() end)
    return true, "used " .. tool.Name
end

function UAPrimitives.scan_interactables(radius)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    radius = radius or 100
    local out = {}
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") then
            local p = inst.Parent
            if p and p:IsA("BasePart") then
                local d = (p.Position - hrp.Position).Magnitude
                if d <= radius then
                    table.insert(out, {
                        cls = inst.ClassName,
                        name = p.Name,
                        dist = math.floor(d),
                        pos = { math.floor(p.Position.X), math.floor(p.Position.Y), math.floor(p.Position.Z) },
                    })
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.dist < b.dist end)
    return out
end

