                    local dist = rel.Magnitude
                    if dist < 500 then
                        local rx = rel.X * math.cos(yaw) - rel.Z * math.sin(yaw)
                        local rz = rel.X * math.sin(yaw) + rel.Z * math.cos(yaw)
                        local angle = math.atan2(rx, -rz)
                        local nx = math.sin(angle) * 0.38
                        local nz = -math.cos(angle) * 0.38
                        seen[inst] = true
                        local blip = blips[inst]
                        if not blip then
                            blip = Instance.new("Frame")
                            blip.Size = UDim2.fromOffset(6, 6)
                            blip.AnchorPoint = Vector2.new(0.5, 0.5)
                            blip.BackgroundColor3 = Color3.fromRGB(255, 200, 80)
                            blip.BorderSizePixel = 0
                            blip.Parent = box
                            V4Corner(blip, 3)
                            blips[inst] = blip
                        end
                        blip.Position = UDim2.new(0.5 + nx, 0, 0.5 + nz, 0)
                        local alpha = math.clamp(1 - dist / 500, 0.3, 1)
                        blip.BackgroundTransparency = 1 - alpha
                    end
                end
            end
            for inst, blip in pairs(blips) do
                if not seen[inst] then blip:Destroy() blips[inst] = nil end
            end
        end))
        return "Sound Radar enabled."
    end
}

