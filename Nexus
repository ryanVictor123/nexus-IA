local UAAgent = {
    active = false,
    goal = nil,
    iteration = 0,
    maxIterations = 50,
    interval = 2,
    history = {},
    startTime = 0,
    killSwitch = false,
}

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift and UAAgent.active then
        UAAgent.killSwitch = true
    end
end)

local function UABuildPrompt()
    local pack = UA.skills[UA.genre] or UA.skills.sandbox
    return [[You are a UNIVERSAL AGENT playing Roblox.
You adapt to ANY genre. You detected the current genre automatically.

CURRENT GENRE: ]] .. UA.genre .. [[ (confidence ]] .. math.floor(UA.confidence * 100) .. [[%)

PRIORITY SKILLS IN THIS GENRE:
]] .. table.concat(pack.priorities, ", ") .. [[

PLAYER'S GOAL: ]] .. tostring(UAAgent.goal) .. [[

RESPOND **ONLY WITH JSON**, structure:
{
  "reasoning": "why",
  "skill": "skill_name",
  ...args
}

AVAILABLE SKILLS (universal):
- navigate_to {x, y, z, timeout}
- jump
- interact_nearest           (ProximityPrompt)
- click_nearest_collectible  (ClickDetector)
- click_button {text}
- say {text}
- equip_tool {name}
- use_tool
- aim_at_enemy
- attack_nearest
- heal_self
- follow_character {name}
- explore

RULES:
1. ONE skill at a time.
2. If goal was achieved: { "skill": "done", "reason": "..." }
3. If stuck after 4 attempts: { "skill": "stuck", "reason": "..." }
4. Use only observation data.
5. Prioritize skills from the detected genre when it makes sense.
6. Pure JSON, no markdown.
]]
end

local function UAStep()
    local obs = UAPerceive()
    local obsText = HttpService:JSONEncode(obs)
    local histText = #UAAgent.history > 0 and table.concat(UAAgent.history, "\n") or "(empty)"

    local ok, resp = OpenRouterRequestWithFallback(
        "",
        {
            { role = "system", content = UABuildPrompt() },
            { role = "user", content = "OBSERVATION:\n" .. obsText .. "\n\nHISTORY:\n" .. histText .. "\n\nITERATION: " .. UAAgent.iteration },
        },
        0.3, 1024, false
    )
    if not ok then return false, "LLM failed: " .. tostring(resp) end

    local cleaned = resp:gsub("^```json%s*", ""):gsub("^```%s*", ""):gsub("%s*```$", "")
    local jsonStr = cleaned:match("(%b{})") or cleaned
    local okParse, decoded = pcall(function() return HttpService:JSONDecode(jsonStr) end)
    if not okParse then return false, "Invalid JSON" end
    return true, decoded
end

local function UARunLoop()
    if not AddMessage then UAAgent.active = false return end
    AddMessage("🌐 [UNIVERSAL AGENT] Active. Genre: " .. UA.genre .. " | Goal: " .. UAAgent.goal, false, false, nil, "AGENT")
    AddMessage("🛑 RightShift to stop.", false, false)

    while UAAgent.active do
        if UAAgent.killSwitch then AddMessage("🛑 Stopped.", false, false) break end
        if UAAgent.iteration >= UAAgent.maxIterations then AddMessage("⏱️ Limit reached.", false, false) break end

        UAAgent.iteration = UAAgent.iteration + 1
        AddMessage("🧠 Deciding #" .. UAAgent.iteration .. "...", false, false)

        local ok, decision = UAStep()
        if not ok then
            AddMessage("⚠️ " .. decision, false, false)
            task.wait(2)
            continue
        end

        local reasoning = tostring(decision.reasoning or "")
        local skill = tostring(decision.skill or "?")
        AddMessage("💭 " .. reasoning, false, false)
        AddMessage("⚡ " .. skill, false, false)

        if skill == "done" then
            AddMessage("🎉 OBJECTIVE: " .. tostring(decision.reason or "ok"), false, false)
            break
        elseif skill == "stuck" then
            AddMessage("🤔 Stuck: " .. tostring(decision.reason or ""), false, false)
            break
        end

        local args = {}
        for k, v in pairs(decision) do
            if k ~= "reasoning" and k ~= "skill" then args[k] = v end
        end

        local execOk, execMsg = UARunSkill(skill, args)
        if execOk then UARecordSuccess(skill) else UARecordFail(skill) end

        table.insert(UAAgent.history, "[#" .. UAAgent.iteration .. "] " .. skill .. " → " .. tostring(execMsg))
        if #UAAgent.history > 12 then table.remove(UAAgent.history, 1) end

        task.wait(UAAgent.interval)
    end
    UAAgent.active = false
    AddMessage("🏁 Session ended. " .. UAAgent.iteration .. " iterations.", false, false)
end

