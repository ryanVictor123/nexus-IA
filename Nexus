local AntiSpam = {
    LastMessageTime = 0,
    LastMessageContent = "",
    CooldownTime = 2.0,
    CooldownRepetition = 8.0,
    RecentHashes = {},
    RecentWindow = 15,
    MaxInWindow = 5,
    MaxLength = 2000,
}

local function HashString(str)
    local hash = 0
    for i = 1, #str do
        hash = (hash * 31 + string.byte(str, i)) % 2147483647
    end
    return hash
end

local function CheckSpam(messageText)
    local currentTime = tick()
    local timeDiff = currentTime - AntiSpam.LastMessageTime

    if #messageText > AntiSpam.MaxLength then
        return false, "Message too long (" .. #messageText .. " chars). Limit: " .. AntiSpam.MaxLength .. "."
    end

    if timeDiff < AntiSpam.CooldownTime then
        local wait = string.format("%.1f", AntiSpam.CooldownTime - timeDiff)
        return false, "Easy there! Wait " .. wait .. " more seconds before sending."
    end

    if messageText == AntiSpam.LastMessageContent and timeDiff < AntiSpam.CooldownRepetition then
        return false, "Repeated message. Try something different."
    end

    local now = currentTime
    local newRecent = {}
    for _, t in ipairs(AntiSpam.RecentHashes) do
        if now - t < AntiSpam.RecentWindow then
            table.insert(newRecent, t)
        end
    end
    AntiSpam.RecentHashes = newRecent

    if #AntiSpam.RecentHashes >= AntiSpam.MaxInWindow then
        return false, "You're sending messages too fast. Wait a few seconds."
    end

    local msgHash = HashString(messageText:sub(1, 50):lower())
    if AntiSpam.LastHash == msgHash and timeDiff < AntiSpam.CooldownRepetition then
        return false, "Message too similar to the previous one."
    end

    table.insert(AntiSpam.RecentHashes, now)
    AntiSpam.LastMessageTime = currentTime
    AntiSpam.LastMessageContent = messageText
    AntiSpam.LastHash = msgHash

    return true, ""
end

