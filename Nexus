local function IsCodeSafe(code)
    return true, "OK"
end

local function ExecuteDynamicCode(code)
    local isSafe, reason = IsCodeSafe(code)
    if not isSafe then
        warn("[DYNAMIC EXECUTION BLOCKED]: " .. reason)
        return false, reason
    end

    local loadFunc = loadstring or (syn and syn.loadstring) or (Fluxus and Fluxus.loadstring)
    if not loadFunc then return false, "Executor does not support loadstring." end

    local formattedCode = [[
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local Character = LocalPlayer and LocalPlayer.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        ]] .. code

    local compiledCode, compileErr = loadFunc(formattedCode)
    if not compiledCode then return false, "Luau compilation error: " .. tostring(compileErr) end

    local success, execErr = pcall(compiledCode)
    if not success then return false, "Runtime error: " .. tostring(execErr) end

    return true, "Executed successfully!"
end

