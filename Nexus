    desc = "Searches game instances by class or name (partial).",
    args = { "class (optional string)", "name (optional string)", "root (optional string: 'workspace', 'replicatedstorage', 'playergui', 'lighting')" },
    fn = function(args)
        local targetClass = args.class and tostring(args.class):lower() or nil
        local targetName  = args.name  and tostring(args.name):lower()  or nil
        local rootName    = args.root  and tostring(args.root):lower()  or "workspace"
        local root = workspace
        if rootName == "replicatedstorage" then root = ReplicatedStorage
        elseif rootName == "playergui" then root = LocalPlayer:FindFirstChild("PlayerGui") or workspace
        elseif rootName == "lighting" then root = Lighting
        elseif rootName == "players" then root = Players
        end
        if not root then return "Invalid root." end

        local results = {}
        local count = 0
        for _, inst in ipairs(root:GetDescendants()) do
            local matchClass = not targetClass or inst.ClassName:lower():find(targetClass, 1, true)
            local matchName  = not targetName  or inst.Name:lower():find(targetName, 1, true)
            if matchClass and matchName then
                count = count + 1
                if count <= 40 then
                    local path = inst:GetFullName()
                    table.insert(results, path)
