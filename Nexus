                        0,
                        -1
                    )

                local yaw = math.atan2(
                    -camLook.X,
                    -camLook.Z
                )

                local seen = {}

                for _, p in ipairs(
                    Players:GetPlayers()
                ) do

                    if p ~= LocalPlayer
                        and p.Character then

                        local hrp =
                            p.Character:FindFirstChild(
                                "HumanoidRootPart"
                            )

