            "Example: Automatically farms nearby coins",
            60
        )

    local inPrompt =
        makeInput(
            148,
            "BEHAVIOR INSTRUCTION (OPTIONAL)",
            "Example: You now know how to farm nearby coins...",
            100
        )

    local inTools =
        makeInput(
            272,
            "CORE TOOLS (COMMA SEPARATED)",
            "Example: scan_interactables, nearest_player",
            40
        )

    local inCode =
        makeInput(
            336,
            "LUAU CODE (OPTIONAL — RUNS IN SANDBOX)",
            "Example: local h = api.get_humanoid()\nif h then h.WalkSpeed = 32 end",
            140
        )

    local statusLbl =
        Instance.new("TextLabel")

    statusLbl.Position =
