local loadingSteps = {
    { pct = 10,  text = "Initializing..." },
    { pct = 24,  text = "Loading modules..." },
    { pct = 42,  text = "Activating systems..." },
    { pct = 58,  text = "Connecting tools..." },
    { pct = 74,  text = "Syncing..." },
    { pct = 88,  text = "Preparing interface..." },
    { pct = 100, text = "Done!" },
}

task.spawn(function()
    task.wait(0.6)

    local currentPct = 0

    for _, step in ipairs(loadingSteps) do
        Animate(LoadingStatus, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextTransparency = 1 })

        task.wait(0.18)

        LoadingStatus.Text = step.text

        Animate(LoadingStatus, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextTransparency = 0 })

        local startPct = currentPct
        local targetPct = step.pct

        local duration = math.random(28, 40) / 100
        local elapsed = 0

        while elapsed < duration do
            elapsed += task.wait()

            local alpha = math.clamp(elapsed / duration, 0, 1)

            local eased = 1 - (1 - alpha)^3

            currentPct = math.floor(startPct + ((targetPct - startPct) * eased))

            PercentLabel.Text = currentPct .. "%"

            ProgressFill.Size = UDim2.new(currentPct / 100, 0, 1, 0)
        end

        currentPct = targetPct

        PercentLabel.Text = currentPct .. "%"

        ProgressFill.Size = UDim2.new(currentPct / 100, 0, 1, 0)
    end

    task.wait(0.45)

    Animate(LoadingStatus, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextTransparency = 1 })

    task.wait(0.2)

    LoadingStatus.Text = "Connected"

    Animate(LoadingStatus, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextTransparency = 0 })

    task.wait(0.45)

    Animate(Logo, 0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.In, { BackgroundTransparency = 1 })
    Animate(LogoStroke, 0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In, { Transparency = 1 })
