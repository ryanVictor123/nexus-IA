NEXUS_TOOLS.find_patterns = {
    desc = "Groups instances by name prefix (before digits/underscore) and shows groups with many repetitions (useful for tiles, spawns, waypoints).",
    args = { "root (default workspace)", "min_count (default 5)" },
    fn = function(args)
        local r = tostring(args.root or "workspace"):lower()
        local root = workspace
        if r == "replicatedstorage" then root = ReplicatedStorage
        elseif r == "game" then root = game end
        local min_count = tonumber(args.min_count) or 5

        local groups = {}
        for _, inst in ipairs(root:GetDescendants()) do
            local base = inst.Name:gsub("%d+$", ""):gsub("[_%-]+$", "")
            if #base >= 3 then
                groups[base] = groups[base] or { count = 0, class = inst.ClassName, sample = inst:GetFullName() }
                groups[base].count = groups[base].count + 1
            end
        end

        local arr = {}
        for name, data in pairs(groups) do
            if data.count >= min_count then
                table.insert(arr, { name = name, count = data.count, class = data.class, sample = data.sample })
            end
        end
        table.sort(arr, function(a, b) return a.count > b.count end)

        local lines = { "=== REPEATED PATTERNS (min " .. min_count .. ") ===" }
        for i = 1, math.min(#arr, 25) do
            local g = arr[i]
            table.insert(lines, string.format("- %s [%s] x%d  (e.g. %s)", g.name, g.class, g.count, g.sample))
        end
        if #lines == 1 then return "No significant pattern found." end
        return table.concat(lines, "\n")
    end
}

