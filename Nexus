-- ============================================================
-- INTEGRAÇÃO FINAL: registra tools dos plugins no NEXUS_TOOLS
-- ============================================================
_G.NEXUS_CATALOG = Catalog

for toolName, info in pairs(Catalog.GetActiveCustomTools()) do
    if not NEXUS_TOOLS[toolName] then
        local spec = info.spec
        NEXUS_TOOLS[toolName] = {
            desc = spec.desc .. " (plugin: " .. info.plugin .. ")",
            args = spec.args or {},
            fn = function(args)
                if spec.code and spec.code ~= "" then
                    local ok, result = Sandbox.Run(info.plugin, spec.code, args)
                    if ok then
                        return tostring(result or "ok")
                    else
                        return "[SANDBOX BLOCKED] " .. tostring(result)
                    end
                elseif spec.composes and #spec.composes > 0 then
                    local ok, result = Catalog.ExecuteCustomTool(toolName, NEXUS_TOOLS, args)
                    return tostring(result)
                end
                return "[Plugin sem implementação]"
            end,
        }
    end
end
