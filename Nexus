        Animate(button, 0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
            Size = UDim2.new(
                originalSize.X.Scale,
                originalSize.X.Offset - 2,
                originalSize.Y.Scale,
                originalSize.Y.Offset - 2
            )
        })
    end)

    button.MouseButton1Up:Connect(function()
        Animate(button, 0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
            Size = originalSize
        })
    end)
end

