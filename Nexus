local function UARunSkill(skillName, args)
    args = args or {}
    if skillName == "navigate_to" then
        return UAPrimitives.navigate_to(args.x, args.y, args.z, args.timeout)
    elseif skillName == "jump" then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) return true, "jumped" end
        return false, "no humanoid"
    elseif skillName == "interact_nearest" or skillName == "interact_nearest_npc" then
        return UAPrimitives.interact_nearest()
    elseif skillName == "click_nearest_collectible" or skillName == "click_nearest" then
        return UAPrimitives.click_nearest_detector()
    elseif skillName == "click_button" then
        return UAPrimitives.click_button(args.text)
    elseif skillName == "say" then
        return UAPrimitives.say(args.text)
    elseif skillName == "equip_tool" then
        return UAPrimitives.equip_tool(args.name)
    elseif skillName == "use_tool" or skillName == "shoot" then
        return UAPrimitives.use_tool()
    elseif skillName == "heal_self" then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = hum.MaxHealth return true, "healed" end
        return false, "no humanoid"
    elseif skillName == "aim_at_enemy" or skillName == "attack_nearest" or skillName == "attack_nearest_enemy" then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false, "no HRP" end
        local best, bestD
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Team ~= LocalPlayer.Team then
                local h = p.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - hrp.Position).Magnitude
                    if not bestD or d < bestD then best, bestD = h, d end
                end
            end
        end
        if not best then return false, "no enemy" end
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(best.Position.X, hrp.Position.Y, best.Position.Z))
        return UAPrimitives.use_tool()
    elseif skillName == "follow_character" then
        local n = tostring(args.name or ""):lower()
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name:lower():find(n, 1, true) or p.DisplayName:lower():find(n, 1, true) then
                local thrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if thrp and myHrp then
                    myHrp.CFrame = CFrame.new(thrp.Position + (thrp.CFrame.LookVector * -3))
                    return true, "near " .. p.Name
                end
            end
        end
        return false, "target not found"
    elseif skillName == "explore" then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hrp and hum then
            local angle = math.random() * math.pi * 2
            local target = hrp.Position + Vector3.new(math.cos(angle) * 50, 0, math.sin(angle) * 50)
            hum:MoveTo(target)
            return true, "exploring"
        end
        return false, "no character"
    else
        return false, "skill not implemented: " .. skillName
    end
end

