DeleteChat = function(id)
    if not Chats[id] then return end

    local wasCurrent = (id == CurrentChatId)
    Chats[id] = nil

    if wasCurrent then
        local nextId = GetMostRecentChatId()
        if nextId then
            CurrentChatId = nextId
            Messages = Chats[nextId].messages

            for _, child in ipairs(ChatScroll:GetChildren()) do
                if child:IsA("Frame") then
                    child:Destroy()
                end
            end
            ClearSuggestions()
            HideThinking()

            for _, msg in ipairs(Messages) do
                AddMessage(msg.content, msg.role == "user", false)
            end
            if #Messages == 0 then
                AddMessage("Starting a new chat. What's up?", false, false)
            end
        else
            StartNewChat()
            return
        end
    end

    RenderChatList()
    SaveChats()
end

