NEXUS_TOOLS.diff_snapshot = {
    desc = "Compares current state with a saved snapshot and shows added/removed.",
    args = { "root (default replicatedstorage)", "tag (default 'default')" },
    fn = function(args)
        local r = tostring(args.root or "replicatedstorage"):lower()
        local tag = tostring(args.tag or "default")
        local prev = _G._nexusSnap and _G._nexusSnap[tag]
        
        if not prev then return "Snapshot '" .. tag .. "' does not exist. Use take_snapshot first." end
        
        local root = ReplicatedStorage
        if r == "workspace" then root = workspace
        elseif r == "game" then root = game end

        local now = {}
        for _, c in ipairs(root:GetDescendants()) do now[c:GetFullName()] = true end

        local added, removed = {}, {}
        for path in pairs(now) do if not prev.data[path] then table.insert(added, path) end end
        for path in pairs(prev.data) do if not now[path] then table.insert(removed, path) end end

        local lines = { "=== DIFF SINCE " .. prev.time .. " ===" }
        lines[#lines+1] = "Added: " .. #added
        for i = 1, math.min(20, #added) do lines[#lines+1] = "  + " .. added[i] end
        lines[#lines+1] = "Removed: " .. #removed
        for i = 1, math.min(20, #removed) do lines[#lines+1] = "  - " .. removed[i] end
        return table.concat(lines, "\n")
    end
}

local function ResolveToolName(name)
    if not name or name == "" then return nil end

    local n = tostring(name):lower():gsub("%s+", "_"):gsub("%-", "_")

    -- 1. Nome exato
    if NEXUS_TOOLS[n] then return n end

    -- 2. Match por sufixo/prefixo (ex: "get_players" → "list_players")
    if #n >= 5 then
        for realName, _ in pairs(NEXUS_TOOLS) do
            -- Se termina com o mesmo radical, provável match
            if realName:sub(-#n) == n or n:sub(-#realName) == realName then
                return realName
            end
            -- Match parcial
            if realName:find(n, 1, true) or n:find(realName, 1, true) then
                return realName
            end
        end
    end

    return nil
end

local function ExecuteToolCall(name, args)
    local resolved = ResolveToolName(name)

    if not resolved then
        local suggestions = {}
        local nLower = tostring(name):lower()
        for realName, _ in pairs(NEXUS_TOOLS) do
            if realName:sub(1, 3) == nLower:sub(1, 3) then
                table.insert(suggestions, realName)
            end
        end
        local sugStr = #suggestions > 0
            and (" Did you mean: " .. table.concat(suggestions, ", "):sub(1, 200) .. "?")
            or ""

        return "[ERROR] Unknown tool: '" .. tostring(name) .. "'." .. sugStr
    end

    if resolved ~= tostring(name):lower() then
        print("[NEXUS] Tool resolved: '" .. tostring(name) .. "' → '" .. resolved .. "'")
    end

    local tool = NEXUS_TOOLS[resolved]
    if not tool or type(tool.fn) ~= "function" then
        return "[ERROR] Tool '" .. resolved .. "' has no executable function."
    end

    if args == nil then args = {} end
    if type(args) == "string" then
        local ok, decoded = pcall(function() return HttpService:JSONDecode(args) end)
        if ok and type(decoded) == "table" then
            args = decoded
        else
            args = {}
        end
    end
    if type(args) ~= "table" then args = {} end

    local ok, result = pcall(tool.fn, args)
    if not ok then
        return "[ERROR in " .. resolved .. "]: " .. tostring(result)
    end
    return tostring(result)
end

local function BuildToolsDescription()
    local groups = {}
    local order = {}
    for name, tool in pairs(NEXUS_TOOLS) do
        local prefix = name:match("^([a-z]+)_") or "other"
        if not groups[prefix] then
            groups[prefix] = {}
            table.insert(order, prefix)
        end
        table.insert(groups[prefix], { name = name, tool = tool })
    end

    table.sort(order)
    for _, p in ipairs(order) do
        table.sort(groups[p], function(a, b) return a.name < b.name end)
    end

    local lines = { "AVAILABLE TOOLS (you can invoke via 'tool_calls'):" }

    -- ✅ O LOOP QUE FALTOU:
    for _, prefix in ipairs(order) do
        table.insert(lines, "")
        table.insert(lines, "=== " .. prefix:upper() .. " ===")
        
        for _, entry in ipairs(groups[prefix]) do
            local t = entry.tool
            local desc = (t.desc or ""):sub(1, 60)
            table.insert(lines, "  ▸ " .. entry.name .. " | " .. desc)
        end
    end

    table.insert(lines, "")
    table.insert(lines, "IMPORTANT: use EXACTLY the names listed above.")
    table.insert(lines, "DO NOT invent alternative names.")
    table.insert(lines, "Simple actions (walkspeed, jump, fly, teleport, heal, fullbright, etc) → use execute=true with code.")

    return table.concat(lines, "\n")
end

