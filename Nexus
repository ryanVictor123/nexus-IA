                            -- POSIÇÃO DO PLAYER NO RADAR
                            -- Clamp circular: mantém o ponto DENTRO do círculo
                            -- maxRadius = raio do outerRange (0.82 / 2 = 0.41)
                            -- =================================================

                            local nx = rx / range
                            local nz = rz / range

                            local distance = math.sqrt(
                                nx * nx + nz * nz
                            )

                            local maxRadius = 0.41

                            if distance > maxRadius then
                                local factor = maxRadius / distance

                                nx = nx * factor
                                nz = nz * factor
                            end

                            local dot = dots[p]

                            if not dot then

                                dot =
                                    Instance.new("Frame")

                                dot.Name =
                                    "PlayerDot"

                                dot.Size =
                                    UDim2.fromOffset(
