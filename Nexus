        if #d.results == 0 then return "[web_search] Nenhum resultado para: " .. q end

        local parts = {}
        for _, r in ipairs(d.results) do
            table.insert(parts, "• " .. tostring(r.title))
            if r.snippet and r.snippet ~= "" then
                table.insert(parts, "  " .. tostring(r.snippet):sub(1, 240))
            end
            table.insert(parts, "  └ " .. tostring(r.url))
        end

        return WrapUntrusted(table.concat(parts, "\n"), "web_search:" .. q)
    end
