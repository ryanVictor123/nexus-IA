-- ============================================================
-- INLINE FORMATTING PARSER
-- ============================================================
local function ApplyInlineFormatting(line)
    if not line or line == "" then return line end

    line = line:gsub("&", "&amp;")
    line = line:gsub("<", "&lt;")
    line = line:gsub(">", "&gt;")

    line = line:gsub("%*%*%*(.-)%*%*%*", "<b><i>%1</i></b>")
    line = line:gsub("%*%*(.-)%*%*", "<b>%1</b>")
    line = line:gsub("%*(.-)%*", "<i>%1</i>")
    line = line:gsub("_(.-)_", "<u>%1</u>")
    line = line:gsub("~(.-)~", "<s>%1</s>")
    line = line:gsub("`(.-)`", '<font family="RobotoMono">%1</font>')

    return line
end

