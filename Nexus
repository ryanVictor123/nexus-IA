local PROXY_URL = "https://nexus-proxy.nvlzskidd.workers.dev"

local function ExecuteOpenRouterRequest(apiKey, model, messages, temperature, maxTokens, skipJsonFormat)
    local RequestFunction = GetRequestFunction()
    if not RequestFunction then return false, "Executor sem HTTP compativel.", nil end

    local uid = "unknown"
    pcall(function()
        uid = tostring(game:GetService("Players").LocalPlayer.UserId)
    end)

    local body = {
        user_id = uid,
        model = model,
        messages = messages,
        temperature = temperature or 0.7,
        max_tokens = maxTokens or 8192,
    }
    if not skipJsonFormat then
        body.response_format = { type = "json_object" }
    end

    local encodeSuccess, encodedBody = pcall(function() return HttpService:JSONEncode(body) end)
    if not encodeSuccess then return false, "Erro criando JSON: " .. tostring(encodedBody), nil end

    local requestData = {
        Url = PROXY_URL, url = PROXY_URL,
        Method = "POST", method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
        },
        Body = encodedBody, body = encodedBody
    }

    local success, response = pcall(function() return RequestFunction(requestData) end)
    if not success then return false, "Erro de request: " .. tostring(response), nil end
    if not response then return false, "Proxy retornou vazio.", nil end

    local statusCode = response.StatusCode or response.status_code or response.Status
    local responseBody = response.Body or response.body
    if not responseBody then return false, "Resposta vazia do proxy.", nil end

    local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(responseBody) end)
    if not decodeSuccess then return false, "Resposta nao e JSON valido.", nil end

    if statusCode and tonumber(statusCode) then
        local code = tonumber(statusCode)

        if code == 429 then
            local msg = (decoded and decoded.message) or "Muitas mensagens. Calma ai."
            return false, "[RATE_LIMIT] " .. tostring(msg), false
        end

        if code >= 400 then
            local wasFormatError = (code == 400) and not skipJsonFormat
            if decoded and decoded.error then
                local em = decoded.error
                if type(em) == "table" then
                    em = em.message or em.code or "API error."
                end
                return false, tostring(em), wasFormatError
            end
            return false, "HTTP " .. tostring(code), wasFormatError
        end
    end

    if decoded and decoded.choices and decoded.choices[1] and decoded.choices[1].message then
        local content = decoded.choices[1].message.content
        if content and tostring(content) ~= "" then
            return true, tostring(content), nil
        end
    end

    return false, "Resposta da IA vazia.", nil
end

