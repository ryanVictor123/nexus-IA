                                    1,
                                    0.65,
                                    Color3.fromRGB(
                                        255,
                                        255,
                                        255
                                    )
                                )

                                dots[p] = dot
                            end

                            -- =================================================
                            -- POSIÇÃO FINAL: nx/nz JÁ estão clampados em ±0.41
                            -- Não multiplicar de novo por 0.41 senão o ponto
                            -- fica amontoado no centro.
                            -- =================================================

                            dot.Position =
                                UDim2.new(
                                    0.5 + nx,
                                    0,
                                    0.5 + nz,
                                    0
                                )

                            dot.BackgroundColor3 =
                                p.Team
                                and p.Team.TeamColor.Color
                                or Color3.fromRGB(
                                    255,
                                    255,
                                    255
                                )
                        end
                    end
                end

                -- =================================================
                -- REMOVE PLAYERS QUE NÃO ESTÃO MAIS PRESENTES
                -- =================================================

                for p, dot in pairs(dots) do

                    if not seen[p] then

                        dot:Destroy()

                        dots[p] = nil
