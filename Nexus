local function truncate(str, maxLen)
    str = tostring(str)
    if #str > maxLen then return str:sub(1, maxLen) .. "..." end
    return str
end

local function scanTree(root, maxDepth, maxChildrenPerNode, currentDepth)
    currentDepth = currentDepth or 1
    if currentDepth > maxDepth then return "..." end
    local entries = {}
    local children = root:GetChildren()
    local limit = math.min(#children, maxChildrenPerNode or 20)
    for i = 1, limit do
        local c = children[i]
        local line = c.Name .. " [" .. c.ClassName .. "]"
        if #c:GetChildren() > 0 and currentDepth < maxDepth then
            local sub = scanTree(c, maxDepth, maxChildrenPerNode, currentDepth + 1)
            if sub ~= "..." and sub ~= "" then line = line .. " { " .. sub .. " }" end
        end
        table.insert(entries, line)
    end
    if #children > limit then
        table.insert(entries, "... +" .. (#children - limit) .. " items")
    end
    return table.concat(entries, ", ")
end

