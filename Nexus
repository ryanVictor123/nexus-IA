local function BuildAPI(pluginName)

    local function character()
        return LP and LP.Character
    end

    local function humanoid()
        local c = character()

        return c
            and c:FindFirstChildOfClass("Humanoid")
    end

    local function hrp()
        local c = character()

        return c
            and c:FindFirstChild("HumanoidRootPart")
    end

    local budget = {
        say = 0,
        teleport = 0
    }

    local api = {}

    api.get_local_player = function()
        return {
            name = LP.Name,
            display = LP.DisplayName,
            id = LP.UserId
        }
    end

    api.get_character = function()
        return character()
    end

    api.get_humanoid = function()
        return humanoid()
    end

    api.get_hrp = function()
        return hrp()
    end

    api.get_health = function()
        local h = humanoid()

        return h
            and h.Health
            or 0
    end

    api.get_position = function()
        local r = hrp()

        return r
            and r.Position
            or Vector3.new(0, 0, 0)
    end

    api.set_walkspeed = function(n)
        n = tonumber(n)

        if not n then
            return false
        end

        n = math.clamp(n, 0, 500)

        local h = humanoid()

        if h then
            h.WalkSpeed = n
            return true
        end

        return false
    end

    api.set_jumppower = function(n)
        n = tonumber(n)

        if not n then
            return false
        end

        n = math.clamp(n, 0, 500)

        local h = humanoid()

        if h then
            h.JumpPower = n
            return true
        end

        return false
    end

    api.set_gravity = function(n)
        n = tonumber(n)

        if not n then
            return false
        end

        n = math.clamp(n, 0, 500)

        workspace.Gravity = n

        return true
    end

    api.teleport_to = function(x, y, z)
        budget.teleport =
            budget.teleport + 1

        if budget.teleport > 20 then
            return false
        end

        x = tonumber(x)
        y = tonumber(y)
        z = tonumber(z)

        if not (x and y and z) then
            return false
        end

        local r = hrp()

        if r then
            r.CFrame = CFrame.new(x, y, z)
            return true
        end

        return false
    end

    api.heal = function(n)
        n = tonumber(n) or 100

        local h = humanoid()

        if h then
            h.Health = math.min(
                h.MaxHealth,
                h.Health + n
            )

            return true
        end

        return false
    end

    api.say = function(text)
        budget.say =
            budget.say + 1

        if budget.say > 3 then
            return false
        end

        text = tostring(text or "")
            :sub(1, 200)

        pcall(function()

            local legacy =
                ReplicatedStorage:FindFirstChild(
                    "DefaultChatSystemChatEvents"
                )

            if legacy
                and legacy:FindFirstChild(
                    "SayMessageRequest"
                ) then

                legacy.SayMessageRequest:FireServer(
                    text,
                    "All"
                )

            else

                local TCS =
                    game:GetService(
                        "TextChatService"
                    )

                if TCS.ChatVersion
                    == Enum.ChatVersion.TextChatService then

                    local ch =
                        TCS.TextChannels:FindFirstChild(
                            "RBXGeneral"
                        )

                    if ch then
                        ch:SendAsync(text)
                    end
                end
            end
        end)

        return true
    end

    api.get_players = function()

        local out = {}

        for _, p in ipairs(
            Players:GetPlayers()
        ) do

            local c = p.Character

            local h =
                c
                and c:FindFirstChildOfClass(
                    "Humanoid"
                )

            local r =
                c
                and c:FindFirstChild(
                    "HumanoidRootPart"
                )

            table.insert(
                out,
                {
                    name = p.Name,
                    display = p.DisplayName,

                    health =
                        h and h.Health or 0,

                    max_health =
                        h and h.MaxHealth or 0,

                    position =
                        r
                        and r.Position
                        or Vector3.new(0, 0, 0),
                }
            )
        end

        return out
    end

    api.get_nearest_player = function()

        local me = hrp()

        if not me then
            return nil
        end

        local best, bd

        for _, p in ipairs(
            Players:GetPlayers()
        ) do

            if p ~= LP and p.Character then

                local r =
                    p.Character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if r then

                    local d =
                        (
                            r.Position
                            - me.Position
                        ).Magnitude

                    if not bd or d < bd then
                        best = p
                        bd = d
                    end
                end
            end
        end

        if best then
            return {
                name = best.Name,
                display = best.DisplayName,
                distance = bd
            }
        end

        return nil
    end

    api.log = function(msg)
        print(
            "[PLUGIN:"
                .. tostring(pluginName)
                .. "]",
            tostring(msg)
        )
    end

    api.wait = function(sec)
        sec = math.clamp(
            tonumber(sec) or 0,
            0,
            5
        )

        task.wait(sec)
    end

    return api
end

function Sandbox.Run(
    pluginName,
    code,
    args
)

    if type(code) ~= "string"
        or code == "" then

        return false, "Empty code."
    end

    if #code > 8000 then
        return false, "Code is too large."
    end

    for _, word in ipairs(BLOCKED) do

        local pattern =
            "%f[%a_]"
            .. word:gsub("%%", "%%%%")
            .. "%f[^%a_]"

        if code:find(pattern) then
            return false,
                "Blocked access: "
                .. word
        end
    end

    local env = {}

    for k, v in pairs(SAFE_GLOBALS) do
        env[k] = v
    end

    env.__args = args or {}
    env.api = BuildAPI(pluginName)

    setmetatable(
        env,
        {
            __index = function(_, key)
                error(
                    "Plugin attempted to access forbidden global: "
                    .. tostring(key),
                    2
                )
            end,

            __newindex = function(_, key, _)
                error(
                    "Plugin attempted to write global: "
                    .. tostring(key),
                    2
                )
            end,
        }
    )

    local loader =
        loadstring
        or load

    if not loader then
        return false,
            "loadstring is unavailable."
    end

    local fn, compileErr =
        loader(
            code,
            "=plugin_"
                .. tostring(pluginName)
        )

    if not fn then
        return false,
            "Compilation error: "
            .. tostring(compileErr)
    end

    local co =
        coroutine.create(
            function()

                setfenv(
                    fn,
                    env
                )

                return fn()
            end
        )

    local startT = tick()
    local TIMEOUT = 3
    local done = false

    task.spawn(function()

        while not done
            and tick() - startT < TIMEOUT do

            task.wait(0.05)
        end

        if not done then
            pcall(
                coroutine.close,
                co
            )
        end
    end)

    local ok, a =
        coroutine.resume(co)

    done = true

    if not ok then
        return false,
            "Runtime error: "
            .. tostring(a)
    end

    if coroutine.status(co)
        ~= "dead" then

        return false,
            "Timeout (>"
            .. TIMEOUT
            .. "s)"
    end

    return true, a
end

