-- Secret para assinar payload (NÃO comente os bytes)
local _SK = {
    {0x4E,0x45,0x58},
    {0x55,0x53,0x5F},
    {0x53,0x45,0x43},
    {0x52,0x45,0x54,0x5F},
    {0x32,0x30,0x32,0x35},
}

local function _BuildSecret()
    local bytes = {}
    for _, part in ipairs(_SK) do
        for _, b in ipairs(part) do
            table.insert(bytes, b)
        end
    end
    local s = ""
    for _, b in ipairs(bytes) do s = s .. string.char(b) end
    return s
end

local SECRET_KEY = _BuildSecret()

