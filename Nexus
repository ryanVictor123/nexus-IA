    pcall(function()
        writefile("nexus_agent_memory.json", HttpService:JSONEncode({
            gameSignature = UA.gameSignature,
            actionMemory = UA.actionMemory,
            workingInstances = UA.workingInstances,
        }))
    end)
end

local function UALoad()
    if not readfile then return end
    pcall(function()
        local content = readfile("nexus_agent_memory.json")
        if content and content ~= "" then
            local decoded = HttpService:JSONDecode(content)
            if decoded.gameSignature == UA.gameSignature then
                UA.actionMemory = decoded.actionMemory or {}
                UA.workingInstances = decoded.workingInstances or {}
            end
        end
    end)
end

local function UARecordSuccess(action)
    UA.actionMemory[action] = UA.actionMemory[action] or { success = 0, fail = 0 }
    UA.actionMemory[action].success = UA.actionMemory[action].success + 1
    UASave()
end

local function UARecordFail(action)
    UA.actionMemory[action] = UA.actionMemory[action] or { success = 0, fail = 0 }
    UA.actionMemory[action].fail = UA.actionMemory[action].fail + 1
    UASave()
end

local function UAActionScore(action)
    local m = UA.actionMemory[action]
    if not m then return 0.5 end
    local total = m.success + m.fail
    if total == 0 then return 0.5 end
    return m.success / total
end

