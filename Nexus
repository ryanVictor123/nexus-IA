local function ShowThinking()
    if ThinkingBubble then ThinkingBubble:Destroy() end
    ThinkingBubble = AddMessage(THINKING_PHRASES[1], false, false)

    ThinkingState.active = true

    local function GetThinkingLabel()
        if not ThinkingBubble then return nil end
        for _, descendant in ipairs(ThinkingBubble:GetDescendants()) do
            if descendant:IsA("TextLabel") and descendant.Text ~= "" then
                if not descendant.Text:match("^%[.*%]$") then
                    return descendant
                end
            end
        end
        return nil
    end

ThinkingState.thread = task.spawn(function()
    local idx = 1
    local startedAt = tick()

    while ThinkingState.active do
        task.wait(2.5)
        if not ThinkingState.active or not ThinkingBubble then break end

        idx = idx + 1
        if idx > #THINKING_PHRASES then idx = 1 end

        local elapsed = math.floor(tick() - startedAt)

        local label = GetThinkingLabel()
        if label and label.Parent then
            Animate(label, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
                TextTransparency = 1
            })
            task.wait(0.15)

            if elapsed >= 20 then
                label.Text = THINKING_PHRASES[idx] .. "  (" .. elapsed .. "s)"
            else
                label.Text = THINKING_PHRASES[idx]
            end

            Animate(label, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
                TextTransparency = 0
            })
        end
    end
end)
end

local function HideThinking()
    ThinkingState.active = false
    if ThinkingState.thread then
        pcall(task.cancel, ThinkingState.thread)
        ThinkingState.thread = nil
    end
    if ThinkingBubble then
        ThinkingBubble:Destroy()
        ThinkingBubble = nil
    end
end

