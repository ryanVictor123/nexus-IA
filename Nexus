local function FormatGameKnowledge()
    local k = GameKnowledge
    if not k.loaded then
        return "=== GAME KNOWLEDGE ===\n(Still loading...)"
    end

    local function topN(map, n)
        local arr = {}
        for key, v in pairs(map) do table.insert(arr, { key, v }) end
        table.sort(arr, function(a, b) return a[2] > b[2] end)
        local out = {}
        for i = 1, math.min(n, #arr) do
            table.insert(out, arr[i][1] .. " (" .. arr[i][2] .. ")")
        end
        return table.concat(out, ", ")
    end

    local function listOrEmpty(t, empty)
        if #t == 0 then return "  " .. empty end
        return "  " .. table.concat(t, "\n  ")
    end

    return string.format([[
=== GAME KNOWLEDGE (cached at %s) ===
Name: %s
Creator: %s
PlaceId: %s  |  UniverseId: %s
Max Players: %d
Teams: %s

Description:
%s

Total instances (sample): %d
