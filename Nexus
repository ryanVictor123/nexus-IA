local function IsDatePlausible(dateStr)
    if not dateStr or dateStr == "" then return false, "empty_date" end

    local y, m, d = dateStr:match("^(%d%d%d%d)-(%d%d)-(%d%d)$")
    if not y then return false, "bad_format" end

    y, m, d = tonumber(y), tonumber(m), tonumber(d)
    if not y or not m or not d then return false, "bad_numbers" end
    if m < 1 or m > 12 then return false, "bad_month" end
    if d < 1 or d > 31 then return false, "bad_day" end

    local now = os.date("*t")
    local savedTs = os.time({year = y, month = m, day = d, hour = 12})
    local todayTs = os.time({year = now.year, month = now.month, day = now.day, hour = 12})

    if savedTs > todayTs then return false, "future_date" end

    return true, "ok"
end

local function IsUsedPlausible(used)
    if type(used) ~= "number" then return false end
    if used < 0 then return false end
    if used > DAILY_LIMIT + 50 then return false end
    return true
end

