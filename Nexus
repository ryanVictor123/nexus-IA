local function SaveChats()
    if not writefile then return end
    local ok = pcall(function()
        local data = {
            chats = Chats,
            currentId = CurrentChatId,
            version = 1,
        }
        writefile(CHAT_FILE, HttpService:JSONEncode(data))
    end)
    return ok
end

local function LoadChats()
    if not isfile or not readfile then return false end
    local exists = false
    pcall(function() exists = isfile(CHAT_FILE) end)
    if not exists then return false end

    local content
    local ok = pcall(function() content = readfile(CHAT_FILE) end)
    if not ok or not content or content == "" then return false end

    local decoded
    local ok2 = pcall(function() decoded = HttpService:JSONDecode(content) end)
    if not ok2 or type(decoded) ~= "table" then return false end

    if type(decoded.chats) == "table" then
        for id, chat in pairs(decoded.chats) do
            if type(chat) == "table"
                and type(chat.messages) == "table"
                and type(chat.title) == "string" then
                Chats[id] = {
                    id = id,
                    title = chat.title,
                    messages = chat.messages,
                    createdAt = tonumber(chat.createdAt) or tick(),
                    updatedAt = tonumber(chat.updatedAt) or tick(),
                }
            end
        end
    end

    if decoded.currentId and Chats[decoded.currentId] then
        CurrentChatId = decoded.currentId
        Messages = Chats[CurrentChatId].messages
    end
    return true
end

local function CreateNewChat()
    local id = GenerateChatId()
    local chat = {
        id = id,
        title = "New chat",
        messages = {},
        createdAt = tick(),
        updatedAt = tick(),
    }
    Chats[id] = chat
    CurrentChatId = id
    Messages = chat.messages
    SaveChats()
    return chat
end

local function GetCurrentChat()
    if CurrentChatId and Chats[CurrentChatId] then
        return Chats[CurrentChatId]
    end
    return CreateNewChat()
end

local function GetMostRecentChatId()
    local bestId, bestTime = nil, 0
    for id, c in pairs(Chats) do
        if (c.updatedAt or 0) > bestTime then
            bestId, bestTime = id, c.updatedAt
        end
    end
    return bestId
end

