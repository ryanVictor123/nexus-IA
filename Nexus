local function CleanMarkdown(text)
    if not text then return "" end
    local s = tostring(text)
    s = s:gsub("^\239\187\191", "")
    s = s:gsub("```json%s*", "")
    s = s:gsub("```%s*", "")
    s = s:gsub("<[%w_]+>", "")
    s = s:gsub("</[%w_]+>", "")
    s = s:gsub("^%s*[Aa]qui est[áa].-:%s*", "")
    s = s:gsub("^%s*[Hh]ere is.*:%s*", "")
    s = s:gsub("^%s*[Rr]esposta:%s*", "")
    s = s:gsub("^%s*[Jj][Ss][Oo][Nn]:%s*", "")
    return s
end

