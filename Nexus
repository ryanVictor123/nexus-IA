NEXUS_TOOLS.analyze_chat = {
    desc = "Analyzes captured chat: messages per player, probable language, most used words, general tone.",
    args = {},
    fn = function()
        if not V4.ChatLog or #V4.ChatLog == 0 then return "No messages. Run toggle_chat_interceptor first." end

        local byPlayer, wordCount, langHits = {}, {}, { pt = 0, en = 0, es = 0 }
        local toxicWords = { "idiota", "burro", "noob", "lixo", "otário", "vaca", "desgraça", "morre", "noob", "bad", "stupid", "trash" }
        local toxicCount = 0

        local ptK = { "você", "voce", "não", "nao", "está", "esta", "porque", "então", "entao", "aqui", "isso" }
        local enK = { "the", "you", "and", "what", "how", "there", "here", "where", "why", "this" }
        local esK = { "que", "como", "donde", "pero", "porque", "está", "aqui", "todo" }

        for _, msg in ipairs(V4.ChatLog) do
            byPlayer[msg.from] = (byPlayer[msg.from] or 0) + 1
            local lower = msg.text:lower()
            for w in lower:gmatch("%a+") do
                if #w >= 3 then wordCount[w] = (wordCount[w] or 0) + 1 end
            end
            for _, k in ipairs(ptK) do if lower:find("%f[%a]" .. k .. "%f[%A]") then langHits.pt = langHits.pt + 1 break end end
            for _, k in ipairs(enK) do if lower:find("%f[%a]" .. k .. "%f[%A]") then langHits.en = langHits.en + 1 break end end
            for _, k in ipairs(esK) do if lower:find("%f[%a]" .. k .. "%f[%A]") then langHits.es = langHits.es + 1 break end end
            for _, tw in ipairs(toxicWords) do
                if lower:find(tw, 1, true) then toxicCount = toxicCount + 1 break end
            end
        end

        local topWords = {}
        for w, c in pairs(wordCount) do table.insert(topWords, { w, c }) end
        table.sort(topWords, function(a, b) return a[2] > b[2] end)
        local topStr = {}
        for i = 1, math.min(10, #topWords) do table.insert(topStr, topWords[i][1] .. "(" .. topWords[i][2] .. ")") end

        local lang = "pt"
        if langHits.en > langHits.pt then lang = "en" end
        if langHits.es > langHits.pt and langHits.es > langHits.en then lang = "es" end

        local actives = {}
        for p, c in pairs(byPlayer) do table.insert(actives, { p, c }) end
        table.sort(actives, function(a, b) return a[2] > b[2] end)
        local actStr = {}
        for i = 1, math.min(8, #actives) do table.insert(actStr, actives[i][1] .. " (" .. actives[i][2] .. ")") end

        local toxRate = math.floor(toxicCount / #V4.ChatLog * 100)
        local tone
        if toxRate >= 30 then tone = "HOSTILE"
        elseif toxRate >= 10 then tone = "TENSE"
        else tone = "CALM" end

        return table.concat({
            "=== CHAT ANALYSIS ===",
            "Messages: " .. #V4.ChatLog,
            "Probable language: " .. lang,
            "General tone: " .. tone .. " (toxicity ~" .. toxRate .. "%)",
            "Most active: " .. table.concat(actStr, ", "),
            "Keywords: " .. table.concat(topStr, ", "),
        }, "\n")
    end
}

NEXUS_TOOLS.social_graph = {
    desc = "Builds a social map: who's your friend, who's in which team, who's near whom.",
    args = {},
    fn = function()
        local lines = { "=== SOCIAL GRAPH ===" }
        local byTeam = {}
        local myFriends = {}

        for _, p in ipairs(Players:GetPlayers()) do
            local team = p.Team and p.Team.Name or "No team"
            byTeam[team] = byTeam[team] or {}
            table.insert(byTeam[team], p.Name)
            if p ~= LocalPlayer then
                local ok, isFriend = pcall(function() return LocalPlayer:IsFriendsWith(p.UserId) end)
                if ok and isFriend then table.insert(myFriends, p.Name) end
            end
        end

        lines[#lines+1] = "Teams:"
        for team, members in pairs(byTeam) do
            lines[#lines+1] = "  [" .. team .. "] " .. table.concat(members, ", ")
        end
        lines[#lines+1] = "Your friends in server: " .. (#myFriends > 0 and table.concat(myFriends, ", ") or "none")

        local hrp = V4HRP()
        if hrp then
            lines[#lines+1] = "Distances:"
            local dist = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
