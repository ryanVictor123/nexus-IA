        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if not terrain then return "No Terrain found in Workspace." end

        local region = Region3.new(
            Vector3.new(-512, -100, -512),
            Vector3.new(512, 100, 512)
        ):ExpandToGrid(4)

        local ok, materials, occupancy = pcall(function()
            return terrain:ReadVoxels(region, 4)
        end)

        local lines = { "=== TERRAIN ANALYSIS ===" }
        if not ok then
            table.insert(lines, "Could not read voxels: " .. tostring(materials))
            return table.concat(lines, "\n")
        end

        local counts = {}
        local total = 0
        for x = 1, materials.Size.X do
            for y = 1, materials.Size.Y do
                for z = 1, materials.Size.Z do
                    local occ = occupancy[x][y][z]
                    if occ > 0 then
                        local mat = materials[x][y][z]
                        local name = tostring(mat)
                        counts[name] = (counts[name] or 0) + 1
                        total = total + 1
                    end
                end
            end
        end

        local sorted = {}
        for mat, n in pairs(counts) do table.insert(sorted, { mat, n }) end
        table.sort(sorted, function(a, b) return a[2] > b[2] end)

        table.insert(lines, "Occupied voxels: " .. total)
        table.insert(lines, "Predominant materials:")
        for i = 1, math.min(#sorted, 10) do
            table.insert(lines, "  - " .. sorted[i][1] .. ": " .. sorted[i][2])
        end
        return table.concat(lines, "\n")
    end
