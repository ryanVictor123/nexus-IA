local OpenRouterRequestWithFallback

local RETRY_PRESET = "light"

local SmartConfig = {
    FastPathEnabled = true,
    DefaultMaxCycles      = 1,
    AggressiveMaxCycles   = 2,  -- No máximo 2 se for rate limit
    ConservativeMaxCycles = 1,
    FatalMaxCycles        = 1,
    BaseDelay     = 0.5,        -- 0.8s -> 0.5s
    MaxDelay      = 2.0,        -- 4.0s -> 2.0s
    BackoffFactor = 1.5,
    JitterMax     = 0.2,
    DebugLog = true,
}

if RETRY_PRESET == "light" then
    SmartConfig.DefaultMaxCycles = 1
    SmartConfig.AggressiveMaxCycles = 2
    SmartConfig.ConservativeMaxCycles = 1
end

local function SmartLog(msg)
    if SmartConfig.DebugLog then
        print("[SmartRequest] " .. tostring(msg))
    end
end

_G._nexusSmartRequestCancel = false

local function NotifyRetry(attempt, max)
    if _G._nexusRetryNotifier then
        pcall(_G._nexusRetryNotifier, attempt, max)
    end
end

local function PickMaxCycles(lastError)
    if not lastError then return SmartConfig.DefaultMaxCycles end
    local lower = tostring(lastError):lower()

    if lower:find("rate") or lower:find("429") or lower:find("too many") then
        return SmartConfig.AggressiveMaxCycles
    end
    if lower:find("overload") or lower:find("503") or lower:find("504") or lower:find("timeout") then
        return SmartConfig.DefaultMaxCycles
    end
    if lower:find("401") or lower:find("403") or lower:find("invalid") or lower:find("context") then
        return SmartConfig.FatalMaxCycles
    end
    return SmartConfig.ConservativeMaxCycles
end

local function FastPathRequest(apiKey, messages, temperature, maxTokens, isCodeTask)
    local targetModels = GENERAL_MODELS
    local firstModel = targetModels[1]
    if not firstModel then return false, "no model available" end

    local ok, result, needsRetry = ExecuteOpenRouterRequest(
        apiKey, firstModel, messages, temperature, maxTokens, false
    )

    if not ok and needsRetry then
        ok, result = ExecuteOpenRouterRequest(
            apiKey, firstModel, messages, temperature, maxTokens, true
        )
    end

    return ok, result
end

local function SmartRequest(apiKey, messages, temperature, maxTokens, isCodeTask, overrides)
    overrides = overrides or {}
    IAHealth.totalRequests = IAHealth.totalRequests + 1

    local wasHealthy = IAHealth_Check()

    if SmartConfig.FastPathEnabled and wasHealthy then
        SmartLog("IA healthy — Fast Path (1 model, no delay).")

        local ok, result = FastPathRequest(
            apiKey, messages, temperature, maxTokens, isCodeTask
        )

        if ok and type(result) == "string" and result ~= "" then
	    IAHealth_MarkSuccess()
	    SmartLog("Fast Path OK (" .. #result .. " chars).")
	    _G._nexusInternalRetry = false   -- ← adiciona essa linha
	    return true, result, 0
	end

        IAHealth_MarkFail()
        SmartLog("Fast Path failed: " .. tostring(result):sub(1, 120))
        SmartLog("Entering adaptive Slow Path...")
    else
        SmartLog("IA marked as problematic — going straight to Slow Path.")
    end

    local maxCycles = overrides.maxCycles or PickMaxCycles(nil)
    maxCycles = math.clamp(maxCycles, 1, 6)

    IAHealth.totalCyclesUsed = IAHealth.totalCyclesUsed + 1

    local cycle = 0
    local lastError = "No attempt executed."

    while cycle < maxCycles do
        cycle = cycle + 1

        if _G._nexusSmartRequestCancel then
            _G._nexusSmartRequestCancel = false
            return false, "cancelled"
        end

        SmartLog(string.format("Slow Path — cycle %d/%d...", cycle, maxCycles))
		NotifyRetry(cycle, maxCycles)
		_G._nexusInternalRetry = true

local ok, result = OpenRouterRequestWithFallback(
    apiKey, messages, temperature, maxTokens, isCodeTask, true
)

        if ok and type(result) == "string" and result ~= "" then
	    IAHealth_MarkSuccess()
	    SmartLog("Success on cycle " .. cycle .. " (" .. #result .. " chars).")
	    _G._nexusInternalRetry = false
	    return true, result, cycle
	end

        lastError = tostring(result or "unknown error")
		SmartLog("Cycle " .. cycle .. " failed: " .. lastError:sub(1, 120))

-- Rate limit: espera cooldown antes de tentar de novo
local lowerErr = lastError:lower()
local isRateLimit = lowerErr:find("rate") 
    or lowerErr:find("muitas") 
    or lowerErr:find("cooldown")
    or lowerErr:find("429")
    or lowerErr:find("limit")

if isRateLimit then
    local waitCooldown = 15 + math.random() * 10  -- 15-25s
    SmartLog(string.format("⏳ Rate limit — aguardando %.1fs...", waitCooldown))
    task.wait(waitCooldown)
    cycle = cycle - 1
end

        if cycle < maxCycles then
            local newMax = PickMaxCycles(lastError)
            if newMax < maxCycles then
                maxCycles = newMax
                SmartLog("Max cycles adjusted to " .. maxCycles)
            end
        end

        if cycle >= maxCycles then
            IAHealth_MarkFail()
            SmartLog("Budget exhausted after " .. cycle .. " cycles.")
            return false, "exhausted"
        end

        local delay = math.min(
            SmartConfig.BaseDelay * (SmartConfig.BackoffFactor ^ (cycle - 1)),
            SmartConfig.MaxDelay
        )
        delay = delay + math.random() * SmartConfig.JitterMax

        SmartLog(string.format("Waiting %.2fs before next cycle...", delay))
        task.wait(delay)
    end

    return false, "exhausted"
end

OpenRouterRequestWithFallback = function(apiKey, messages, temperature, maxTokens, isCodeTask, skipFirst)
    local targetModels = GENERAL_MODELS
    local lastError = "No model available."

    local startIdx = skipFirst and 2 or 1

    if startIdx > #targetModels then
        startIdx = 1
    end

    for i = startIdx, #targetModels do
        local model = targetModels[i]

        local success, result, needsRetry = ExecuteOpenRouterRequest(
            apiKey, model, messages, temperature, maxTokens, false
        )

        if not success and needsRetry then
            success, result = ExecuteOpenRouterRequest(
                apiKey, model, messages, temperature, maxTokens, true
            )
        end

        if success then
            if not IsRefusalResponse(result) then
                return true, result, model
            end
            lastError = "Model (" .. model .. ") refused."
        else
            lastError = "Model (" .. model .. "): " .. tostring(result)
        end
    end

    return false, "All models failed: " .. lastError
end

