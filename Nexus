local function UADetectGenre()
    local scores = {}
    for genre, _ in pairs(GenreSignals) do scores[genre] = 0 end

    local nameLower = (game.Name or ""):lower()
    local descLower = (CurrentGameDescription or ""):lower()
    local combined = nameLower .. " " .. descLower

    local classCount = {}
    local allNames = {}
    local totalScan = 0

    for _, inst in ipairs(game:GetDescendants()) do
        totalScan = totalScan + 1
        if totalScan > 8000 then break end
        classCount[inst.ClassName] = (classCount[inst.ClassName] or 0) + 1
        local ln = inst.Name:lower()
        if #ln >= 3 and #ln <= 25 then
            allNames[ln] = (allNames[ln] or 0) + 1
        end
    end

    for genre, sig in pairs(GenreSignals) do
        local s = 0
        for _, kw in ipairs(sig.keywords or {}) do
            if combined:find(kw, 1, true) then s = s + 3 end
            if allNames[kw] then s = s + 1.5 end
            for name, cnt in pairs(allNames) do
                if name:find(kw, 1, true) then s = s + math.min(cnt * 0.1, 2) break end
            end
        end
        if sig.hasTools and LocalPlayer:FindFirstChild("Backpack") then
            local toolCount = 0
            for _, c in ipairs(LocalPlayer.Backpack:GetChildren()) do
                if c:IsA("Tool") then toolCount = toolCount + 1 end
            end
            if toolCount >= 2 then s = s + 2 end
        end
        if sig.hasTeams and #Teams:GetTeams() > 0 then s = s + 1.5 end
        if sig.hasLeaderstats then
            local ls = LocalPlayer:FindFirstChild("leaderstats")
            if ls and #ls:GetChildren() > 0 then s = s + 1.5 end
        end
        if sig.hasVehicles and (classCount.VehicleSeat or 0) > 0 then s = s + 3 end
        if sig.darkLighting and Lighting.Brightness < 1 then s = s + 2 end
        if sig.manyPlayers and #Players:GetPlayers() >= 15 then s = s + 1.5 end
        if sig.manyCollectibles then
            local collectibles = 0
            for name, cnt in pairs(allNames) do
                if name:find("coin") or name:find("gem") or name:find("cash") then
                    collectibles = collectibles + cnt
                end
            end
            if collectibles > 20 then s = s + 2 end
        end

        scores[genre] = s
    end

    local bestGenre, bestScore = "sandbox", 0
    for genre, s in pairs(scores) do
        if s > bestScore then bestGenre, bestScore = genre, s end
    end

    local total = 0
    for _, s in pairs(scores) do total = total + s end
    local confidence = total > 0 and bestScore / total or 0

    UA.genre = bestGenre
    UA.confidence = confidence
    UA.gameSignature = tostring(game.PlaceId) .. "_" .. tostring(game.GameId)
    UALoad()

    return bestGenre, confidence, scores
end

