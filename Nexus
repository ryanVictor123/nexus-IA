function C.MergeSuggestions(response)
    if type(response) ~= "table" then return response end
    local pluginSugg = C.GetActiveSuggestions()
    if #pluginSugg == 0 then return response end
    local existing = response.suggestions or {}
    for _,s in ipairs(pluginSugg) do
        if #existing >= 4 then break end
        local dup = false
        for _,e in ipairs(existing) do if e == s then dup = true break end end
        if not dup then table.insert(existing, s) end
    end
    response.suggestions = existing
    return response
end

