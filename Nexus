local function V4Conn(key, conn)
    if V4.Connections[key] then pcall(function() V4.Connections[key]:Disconnect() end) end
    V4.Connections[key] = conn
end
local function V4Disc(key)
    if V4.Connections[key] then
        pcall(function() V4.Connections[key]:Disconnect() end)
        V4.Connections[key] = nil
        return true
    end
    return false
end

local function V4Char() return LocalPlayer and LocalPlayer.Character end
local function V4Hum()
    local c = V4Char(); return c and c:FindFirstChildOfClass("Humanoid")
