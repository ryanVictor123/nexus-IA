_G._nexusRemoteLog = _G._nexusRemoteLog or {}
_G._nexusRemoteHookEnabled = _G._nexusRemoteHookEnabled or false

NEXUS_TOOLS.start_remote_log = {
    desc = "Starts a log of RemoteEvents/Functions called to server for 30 seconds.",
    args = {},
    fn = function()
        if _G._nexusRemoteHookEnabled then return "Already active." end
        _G._nexusRemoteLog = {}
        _G._nexusRemoteHookEnabled = true

        local hooked = {}
        local function Hook(inst)
            if hooked[inst] then return end
            hooked[inst] = true
            local mt = getrawmetatable and getrawmetatable(inst)
            if mt and mt.__namecall then
                local old = mt.__namecall
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod and getnamecallmethod() or "?"
                    if self == inst and (method == "FireServer" or method == "InvokeServer") then
                        local args = { ... }
                        local parts = {}
                        for _, a in ipairs(args) do
                            table.insert(parts, typeof(a) == "Instance" and (a:GetFullName()) or tostring(a))
                        end
                        table.insert(_G._nexusRemoteLog, {
                            time = os.time(),
                            name = inst:GetFullName(),
                            method = method,
                            args = table.concat(parts, ", ")
                        })
                    end
                    return old(self, ...)
                end)
                setreadonly(mt, true)
            end
        end

        for _, inst in ipairs(game:GetDescendants()) do
            if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
                pcall(Hook, inst)
            end
        end

        task.delay(30, function()
            _G._nexusRemoteHookEnabled = false
        end)

        return "Log active for 30s. Use 'get_remote_log' after."
    end
}

NEXUS_TOOLS.get_remote_log = {
    desc = "Returns captured remote log (last 60s).",
    args = {},
    fn = function()
        if not _G._nexusRemoteLog or #_G._nexusRemoteLog == 0 then
            return "No remote logged. Run 'start_remote_log' first."
        end
        local lines = {}
        for i = #_G._nexusRemoteLog, math.max(1, #_G._nexusRemoteLog - 30), -1 do
            local e = _G._nexusRemoteLog[i]
            table.insert(lines, string.format("[%s] %s.%s(%s)",
                os.date("%H:%M:%S", e.time), e.name, e.method, e.args))
        end
        return "Remote log:\n" .. table.concat(lines, "\n")
    end
}

