NEXUS_TOOLS.get_narration = {
    desc = "Returns the narration accumulated so far.",
    args = { "last (default 30)" },
    fn = function(args)
        if not V4.Narration or #V4.Narration == 0 then return "No narration." end
        local n = tonumber(args.last) or 30
        local lines = {}
        for i = math.max(1, #V4.Narration - n + 1), #V4.Narration do
            local e = V4.Narration[i]
            table.insert(lines, "[" .. e.t .. "] " .. e.text)
        end
        return table.concat(lines, "\n")
    end
}

NEXUS_TOOLS.watch_property = {
    desc = "Watches an instance property for N seconds and logs every change. E.g. watch Humanoid's WalkSpeed.",
    args = { "path (string)", "prop (string)", "duration (default 15s)" },
    fn = function(args)
        local path = tostring(args.path or "")
        local prop = tostring(args.prop or "")
        if path == "" or prop == "" then return "Need path and prop." end
        local inst = game
        for _, seg in ipairs(path:split(".")) do inst = inst and inst:FindFirstChild(seg) end
        if not inst then return "Instance not found." end

        local duration = tonumber(args.duration) or 15
        local log = {}
        local start = tick()

        local ok, conn = pcall(function()
            return inst:GetPropertyChangedSignal(prop):Connect(function()
                local val = inst[prop]
                table.insert(log, string.format("[%.1fs] %s = %s", tick() - start, prop, tostring(val)))
            end)
        end)
        if not ok then return "Could not observe " .. prop .. "." end

        task.delay(duration, function()
            conn:Disconnect()
            local summary = "[PROPERTY WATCHER] " .. path .. "." .. prop .. " for " .. duration .. "s:\n"
            if #log == 0 then
                summary = summary .. "(no change detected)"
            else
                summary = summary .. table.concat(log, "\n")
            end
            warn(summary)
        end)
        return "Watching " .. path .. "." .. prop .. " for " .. duration .. "s. Result will appear in F9 console."
    end
}

NEXUS_TOOLS.take_snapshot = {
    desc = "Takes a snapshot of direct children of a root (default ReplicatedStorage) to compare later.",
    args = { "root (default replicatedstorage)", "tag (snapshot name, default 'default')" },
    fn = function(args)
        local r = tostring(args.root or "replicatedstorage"):lower()
        local tag = tostring(args.tag or "default")
        local root = ReplicatedStorage
        if r == "workspace" then root = workspace
        elseif r == "game" then root = game end

        local snap = {}
        for _, c in ipairs(root:GetDescendants()) do
            snap[c:GetFullName()] = { cls = c.ClassName, children = #c:GetChildren() }
        end
        V4.Snap[tag] = { root = r, data = snap, time = os.date("%H:%M:%S") }
        return "Snapshot '" .. tag .. "' saved with " .. (function()
            local n = 0 for _ in pairs(snap) do n = n + 1 end return n
        end)() .. " instances."
    end
}

NEXUS_TOOLS.diff_snapshot = {
    desc = "Compares current state with a saved snapshot and shows added/removed.",
    args = { "root (default replicatedstorage)", "tag (default 'default')" },
    fn = function(args)
        local r = tostring(args.root or "replicatedstorage"):lower()
        local tag = tostring(args.tag or "default")
        local prev = V4.Snap[tag]
        if not prev then return "Snapshot '" .. tag .. "' does not exist. Use take_snapshot first." end
        local root = ReplicatedStorage
        if r == "workspace" then root = workspace
        elseif r == "game" then root = game end

        local now = {}
        for _, c in ipairs(root:GetDescendants()) do now[c:GetFullName()] = true end

        local added, removed = {}, {}
        for path in pairs(now) do if not prev.data[path] then table.insert(added, path) end end
        for path in pairs(prev.data) do if not now[path] then table.insert(removed, path) end end

        local lines = { "=== DIFF SINCE " .. prev.time .. " ===" }
        lines[#lines+1] = "Added: " .. #added
        for i = 1, math.min(20, #added) do lines[#lines+1] = "  + " .. added[i] end
        lines[#lines+1] = "Removed: " .. #removed
        for i = 1, math.min(20, #removed) do lines[#lines+1] = "  - " .. removed[i] end
        return table.concat(lines, "\n")
    end
}

