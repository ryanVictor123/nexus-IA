            -12,
            0,
            60
        )

    statusLbl.BackgroundTransparency =
        1

    statusLbl.Font =
        Enum.Font.Gotham

    statusLbl.TextSize =
        11

    statusLbl.TextWrapped =
        true

    statusLbl.Text =
        ""

    statusLbl.TextColor3 =
        C.TextMuted

    statusLbl.TextXAlignment =
        Enum.TextXAlignment.Left

    statusLbl.TextYAlignment =
        Enum.TextYAlignment.Top

    statusLbl.Parent =
        pagePublish

    local publishBtn =
        Instance.new("TextButton")

    publishBtn.Position =
        UDim2.new(
            0,
            6,
            0,
            570
        )

    publishBtn.Size =
        UDim2.new(
            0,
            180,
            0,
            42
        )

    publishBtn.BackgroundColor3 =
        Color3.fromRGB(
            242,
            242,
            242
        )

    publishBtn.BorderSizePixel =
        0

    publishBtn.Font =
        Enum.Font.GothamBold

    publishBtn.TextSize =
        12

    publishBtn.Text =
        "PUBLISH PLUGIN"

    publishBtn.TextColor3 =
        Color3.fromRGB(
            12,
            12,
            12
        )

    publishBtn.AutoButtonColor =
        false

    publishBtn.Parent =
        pagePublish

    corner(
        publishBtn,
        8
    )

    local publishing =
        false

    publishBtn.MouseButton1Click:Connect(
        function()

            if publishing then
                return
            end

            local name =
                inName.Text
                :gsub(
                    "^%s+",
                    ""
                )
                :gsub(
                    "%s+$",
                    ""
                )

            local desc =
                inDesc.Text
                :gsub(
                    "^%s+",
                    ""
                )
                :gsub(
                    "%s+$",
                    ""
                )

            local prompt =
                inPrompt.Text
                :gsub(
                    "^%s+",
                    ""
                )
                :gsub(
                    "%s+$",
                    ""
                )

            local toolsStr =
                inTools.Text

            local codeStr =
                inCode.Text
                :gsub(
                    "^%s+",
                    ""
                )
                :gsub(
                    "%s+$",
                    ""
                )

            if #name < 3 then

                statusLbl.TextColor3 =
                    C.Red

                statusLbl.Text =
                    "Plugin name is too short (minimum 3 characters)."

                return
            end

            if #desc < 10 then

                statusLbl.TextColor3 =
                    C.Red

                statusLbl.Text =
                    "Description is too short (minimum 10 characters)."

                return
            end

            local tools = {}

            for t in toolsStr:gmatch(
                "[^,]+"
            ) do

                local clean =
                    t:gsub(
                        "%s",
                        ""
                    )

                if clean ~= "" then
                    table.insert(
                        tools,
                        clean
                    )
                end
            end

            local customTools = {}

            if codeStr ~= "" then

                local toolName =
                    name
                    :lower()
                    :gsub(
                        "%s+",
                        "_"
                    )
                    :gsub(
                        "[^%w_]",
                        ""
                    )
                    :sub(
                        1,
                        40
                    )

                table.insert(
                    customTools,
                    {
                        name = toolName,

                        desc =
                            desc:sub(
                                1,
                                200
                            ),

                        args = {},

                        code = codeStr,
                    }
                )
            end

            publishing = true

            publishBtn.Text =
                "ANALYZING..."

            publishBtn.BackgroundColor3 =
                Color3.fromRGB(
                    200,
                    200,
                    200
                )

            statusLbl.TextColor3 =
                C.TextMuted

            statusLbl.Text =
                "AI is reviewing your plugin. This may take up to 15 seconds..."

            task.spawn(
                function()

                    local payload = {

                        name = name,

                        description =
                            desc,

                        prompt_extension =
                            prompt,

                        uses_tools =
                            tools,

                        custom_tools =
                            customTools,

                        suggestions = {},

                        version =
                            "1.0.0",
                    }

                    local ok, data =
                        Catalog.Publish(
                            payload
                        )

                    publishing = false

                    local resetBtn =
                        function()

                            task.wait(
                                3.5
                            )

                            publishBtn.Text =
                                "PUBLISH PLUGIN"

                            publishBtn.BackgroundColor3 =
                                Color3.fromRGB(
                                    242,
                                    242,
                                    242
                                )

                            publishBtn.TextColor3 =
                                Color3.fromRGB(
                                    12,
                                    12,
                                    12
                                )
                        end

                    local clearFields =
                        function()

                            inName.Text =
                                ""

                            inDesc.Text =
                                ""

                            inPrompt.Text =
                                ""

                            inTools.Text =
                                ""

                            inCode.Text =
                                ""
                        end

                    if ok
                        and data
                        and data.status
                            == "approved" then

                        publishBtn.Text =
                            "PUBLISHED ✓"

                        publishBtn.BackgroundColor3 =
                            Color3.fromRGB(
                                50,
                                175,
                                95
                            )

                        publishBtn.TextColor3 =
                            C.Text

                        statusLbl.TextColor3 =
                            C.Green

                        statusLbl.Text =
                            "Plugin approved instantly! ID: "
                            .. tostring(
                                data.id
                                or "?"
                            ):sub(
                                1,
                                8
                            )
                            .. "..."

                        clearFields()

                        task.spawn(
                            function()

                                Catalog.Refresh()

                                RenderCatalog()

                                RenderMine()
                            end
                        )

                        resetBtn()

                    elseif ok
                        and data
                        and data.status
                            == "pending" then

                        publishBtn.Text =
                            "QUEUED"

                        publishBtn.BackgroundColor3 =
                            Color3.fromRGB(
                                200,
                                160,
                                45
                            )

                        publishBtn.TextColor3 =
                            Color3.fromRGB(
                                12,
                                12,
                                12
                            )

                        statusLbl.TextColor3 =
                            C.Yellow

                        statusLbl.Text =
                            "AI verification is currently offline. Your plugin has been queued and will be published automatically when verification is available. ID: "
                            .. tostring(
                                data.id
                                or "?"
                            ):sub(
                                1,
                                8
                            )
                            .. "..."

                        clearFields()

                        task.spawn(
                            function()
                                RenderMine()
                            end
                        )

                        resetBtn()

                    else

                        publishBtn.Text =
                            "REJECTED ✗"

                        publishBtn.BackgroundColor3 =
                            Color3.fromRGB(
                                180,
                                55,
                                55
                            )

                        publishBtn.TextColor3 =
                            C.Text

                        statusLbl.TextColor3 =
                            C.Red

                        statusLbl.Text =
                            "Verification rejected the plugin: "
                            .. tostring(
                                data
                            )

                        resetBtn()
                    end
                end
            )
        end
    )

    Catalog.UI =
        gui

    return gui
end

function Catalog.Open()

    if not Catalog.UI then
        BuildUI()
    end

    Catalog.UI.Enabled =
        true
end

function Catalog.Close()

    if Catalog.UI then
        Catalog.UI.Enabled =
            false
    end
end

