local Catalog = {
    Remote = {},
    Installed = {},
    Loading = false,
    UI = nil,
    OnChange = nil,
}

local function LoadInstalled()
    if not readfile then
        return
    end

    pcall(function()
        local c = readfile(PLUGINS_FILE)

        if c and c ~= "" then
            local d = HttpService:JSONDecode(c)

            if type(d) == "table" then
                Catalog.Installed = d
            end
        end
    end)
end

local function SaveInstalled()
    if not writefile then
        return
    end

    pcall(function()
        writefile(
            PLUGINS_FILE,
            HttpService:JSONEncode(Catalog.Installed)
        )
    end)

    if Catalog.OnChange then
        pcall(
            Catalog.OnChange,
            Catalog.Installed
        )
    end
end

LoadInstalled()

