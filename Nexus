-- ============================================================

local SurvivalState = {
    active        = false,
    autoHeal      = false,
    autoRespawn   = false,
    healThreshold = 0.30,  -- cura quando HP < 30%
    connHeal      = nil,
    connDied      = nil,
}

local function SurvivalStop()
    if SurvivalState.connHeal then
        pcall(function() SurvivalState.connHeal:Disconnect() end)
        SurvivalState.connHeal = nil
    end
    if SurvivalState.connDied then
        pcall(function() SurvivalState.connDied:Disconnect() end)
        SurvivalState.connDied = nil
    end
    SurvivalState.active = false
    SurvivalState.autoHeal = false
    SurvivalState.autoRespawn = false
end

local function SurvivalStart(opts)
    opts = opts or {}
    SurvivalStop()

    SurvivalState.autoHeal    = opts.autoHeal ~= false
    SurvivalState.autoRespawn = opts.autoRespawn ~= false
    SurvivalState.healThreshold = math.clamp(
        tonumber(opts.healThreshold) or 0.30, 0.05, 0.95
    )
    SurvivalState.active = true

    -- Auto-heal
    if SurvivalState.autoHeal then
        SurvivalState.connHeal = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end

            local ratio = hum.Health / hum.MaxHealth
            if ratio >= SurvivalState.healThreshold then return end

            -- Tenta achar poção/food na backpack primeiro
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if bp then
                for _, tool in ipairs(bp:GetChildren()) do
                    if tool:IsA("Tool") then
                        local n = tool.Name:lower()
                        if n:find("potion") or n:find("food") or n:find("heal")
                           or n:find("med") or n:find("apple") or n:find("drink") then
                            pcall(function() hum:EquipTool(tool) end)
                            task.wait(0.15)
                            pcall(function() tool:Activate() end)
                            return
                        end
                    end
                end
            end

            -- Fallback: heal direto (funciona em alguns jogos)
            pcall(function() hum.Health = hum.MaxHealth end)
        end)
    end

    -- Auto-respawn
    if SurvivalState.autoRespawn then
        local function bindChar(char)
            local hum = char:WaitForChild("Humanoid", 5)
            if not hum then return end
            hum.Died:Connect(function()
                if not SurvivalState.autoRespawn then return end
                task.wait(2.5)
                pcall(function()
                    LocalPlayer:LoadCharacter()
                end)
            end)
        end

        if LocalPlayer.Character then
            task.spawn(bindChar, LocalPlayer.Character)
        end

        SurvivalState.connDied = LocalPlayer.CharacterAdded:Connect(bindChar)
    end

    return "Survival ativo. Heal < " .. math.floor(SurvivalState.healThreshold * 100) .. "%, auto-respawn ON."
end

