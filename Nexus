function Catalog.IsInstalled(id)
    return Catalog.Installed[id] ~= nil
end

function Catalog.GetActivePromptExtensions()
    local out = {}

    for _, p in pairs(Catalog.Installed) do
        if p.prompt_extension and p.prompt_extension ~= "" then
            table.insert(
                out,
                "### PLUGIN: "
                    .. p.name
                    .. " ###\n"
                    .. p.prompt_extension
            )
        end
    end

    return table.concat(out, "\n\n")
end

function Catalog.GetActiveCustomTools()
    local tools = {}

    for _, p in pairs(Catalog.Installed) do
        if p.custom_tools then
            for _, ct in ipairs(p.custom_tools) do
                tools[ct.name] = {
                    plugin = p.name,
                    spec = ct
                }
            end
        end
    end

    return tools
end

function Catalog.GetActiveSuggestions()
    local out = {}

    for _, p in pairs(Catalog.Installed) do
        if p.suggestions then
            for _, s in ipairs(p.suggestions) do
                if #out < 6 then
                    table.insert(out, s)
                end
            end
        end
    end

    return out
end

function Catalog.ExecuteCustomTool(name, coreTools, args)
    local ct = Catalog.GetActiveCustomTools()[name]

    if not ct then
        return false, "Tool is not registered."
    end

    if not ct.spec.composes or #ct.spec.composes == 0 then
        return false, "No composed actions."
    end

    local results = {}

    for _, step in ipairs(ct.spec.composes) do
        local coreFn = coreTools[step.tool]

        if not coreFn then
            table.insert(
                results,
                "[SKIP] " .. step.tool
            )
        else
            local stepArgs = {}

            for k, v in pairs(step.args or {}) do
                stepArgs[k] = v
            end

            for k, v in pairs(args or {}) do
                stepArgs[k] = v
            end

            local ok, r = pcall(
                coreFn,
                stepArgs
            )

            table.insert(
                results,
                (ok and "[OK] " or "[ERROR] ")
                    .. step.tool
                    .. ": "
                    .. tostring(r)
            )
        end
    end

    return true, table.concat(results, "\n")
end

function Catalog.Install(id)
    local ok, data = HTTP(
        "GET",
        "/plugins/" .. id
    )

    if not ok then
        return false, data
    end

    if not data.plugin then
        return false, "Plugin not found."
    end

    Catalog.Installed[id] = data.plugin

    SaveInstalled()

    return true, data.plugin
end

function Catalog.Uninstall(id)
    if not Catalog.Installed[id] then
        return false, "Plugin is not installed."
    end

    Catalog.Installed[id] = nil

    SaveInstalled()

    return true
end

function Catalog.Refresh()
    if Catalog.Loading then
        return false, "Already loading..."
    end

    Catalog.Loading = true

    local ok, data = HTTP(
        "GET",
        "/plugins"
    )

    Catalog.Loading = false

    if not ok then
        return false, data
    end

    Catalog.Remote = data.plugins or {}

    return true
end

function Catalog.Publish(pluginData)
    local payload = {}

    for k, v in pairs(pluginData) do
        payload[k] = v
    end

    payload.author_id = tostring(LP.UserId)
    payload.author_name = LP.DisplayName or LP.Name

    local ok, data = HTTP(
        "POST",
        "/plugins",
        payload
    )

    if not ok then
        return false, data
    end

    return true, data
end

function Catalog.MyPlugins()
    local ok, data = HTTP(
        "GET",
        "/my-plugins?user_id="
            .. tostring(LP.UserId)
    )

    if not ok then
        return false, data
    end

    return true, data.plugins or {}
end

